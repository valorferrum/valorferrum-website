---
// src/components/RibbonDivider.astro
// Glossy Gradient-Ribbons als Sektions-Divider (statisch, kein JS)
---

<div class="pointer-events-none relative h-20 md:h-28" aria-hidden="true">
  <svg viewBox="0 0 1440 160" preserveAspectRatio="none" fill="none" class="absolute inset-0 h-full w-full overflow-visible">
    <defs>
      <linearGradient id="vf-rib-a" x1="0" y1="0" x2="1440" y2="0" gradientUnits="userSpaceOnUse">
        <stop stop-color="#EC4899" />
        <stop offset="0.5" stop-color="#A65CF6" />
        <stop offset="1" stop-color="#3B82F6" />
      </linearGradient>
      <linearGradient id="vf-rib-b" x1="1440" y1="0" x2="0" y2="0" gradientUnits="userSpaceOnUse">
        <stop stop-color="#3B82F6" />
        <stop offset="0.55" stop-color="#8B5CF6" />
        <stop offset="1" stop-color="#EC4899" />
      </linearGradient>
      <filter id="vf-rib-blur" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="6" />
      </filter>
    </defs>

    <!-- Ribbon 1: Glow → Kern → Gloss-Highlight -->
    <path d="M-60 118 C 260 30, 560 150, 880 74 S 1380 96, 1500 26" stroke="url(#vf-rib-a)" stroke-width="10" opacity="0.35" filter="url(#vf-rib-blur)" />
    <path d="M-60 118 C 260 30, 560 150, 880 74 S 1380 96, 1500 26" stroke="url(#vf-rib-a)" stroke-width="3.5" stroke-linecap="round" />
    <path d="M-60 114 C 260 26, 560 146, 880 70 S 1380 92, 1500 22" stroke="white" stroke-width="1" opacity="0.5" />

    <!-- Ribbon 2: kreuzend, ruhiger -->
    <path d="M-60 44 C 320 120, 700 20, 1040 108 S 1400 60, 1500 120" stroke="url(#vf-rib-b)" stroke-width="8" opacity="0.25" filter="url(#vf-rib-blur)" />
    <path d="M-60 44 C 320 120, 700 20, 1040 108 S 1400 60, 1500 120" stroke="url(#vf-rib-b)" stroke-width="2.5" stroke-linecap="round" opacity="0.9" />
  </svg>
</div>
---
// Dekorative Laser-Beams aus einem Fokalpunkt (VI 2.0)
---
<svg class="laser-beams" viewBox="0 0 1440 800" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id="vf-focal" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#F8FAFC" stop-opacity="0.9" />
      <stop offset="25%" stop-color="#C49AFF" stop-opacity="0.35" />
      <stop offset="100%" stop-color="#C49AFF" stop-opacity="0" />
    </radialGradient>
  </defs>

  <circle cx="1050" cy="300" r="90" fill="url(#vf-focal)" />
  <circle cx="1050" cy="300" r="3.5" fill="#F8FAFC" />

  <line class="laser-beam" x1="1050" y1="300" x2="-80" y2="640" stroke="#8B5CF6" stroke-width="2" stroke-linecap="round" style="filter: drop-shadow(0 0 6px #8B5CF6);" />
  <line class="laser-beam laser-beam--2" x1="1050" y1="300" x2="240" y2="860" stroke="#EC4899" stroke-width="2" stroke-linecap="round" style="filter: drop-shadow(0 0 6px #EC4899);" />
  <line class="laser-beam laser-beam--3" x1="1050" y1="300" x2="1520" y2="720" stroke="#22D3EE" stroke-width="2" stroke-linecap="round" style="filter: drop-shadow(0 0 6px #22D3EE);" />
  <line class="laser-beam laser-beam--4" x1="1050" y1="300" x2="880" y2="-80" stroke="#FBBF24" stroke-width="2" stroke-linecap="round" style="filter: drop-shadow(0 0 6px #FBBF24);" />
</svg>
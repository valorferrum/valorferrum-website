---
// src/components/ProcessRibbon.astro
// S-förmiges Ribbon, das die Prozess-Steps verbindet (nur Desktop, dekorativ)
---
<div class="pointer-events-none absolute inset-0 hidden md:block" aria-hidden="true">
  <svg viewBox="0 0 100 100" preserveAspectRatio="none" fill="none" class="absolute inset-0 h-full w-full overflow-visible">
    <defs>
      <linearGradient id="vf-proc-grad" x1="0" y1="0" x2="0" y2="1">
        <stop stop-color="#EC4899" />
        <stop offset="0.5" stop-color="#A65CF6" />
        <stop offset="1" stop-color="#3B82F6" />
      </linearGradient>
    </defs>

    <!-- Glow-Layer -->
    <path d="M30 8 C 66 16, 76 28, 72 50 C 68 74, 52 80, 30 92"
          stroke="url(#vf-proc-grad)" stroke-width="10" opacity="0.22"
          vector-effect="non-scaling-stroke" style="filter: blur(6px);" />

    <!-- Kern-Ribbon -->
    <path d="M30 8 C 66 16, 76 28, 72 50 C 68 74, 52 80, 30 92"
          stroke="url(#vf-proc-grad)" stroke-width="2.5" opacity="0.85"
          vector-effect="non-scaling-stroke" stroke-linecap="round" />

    <!-- Licht-Impuls wandert von Step zu Step -->
    <path d="M30 8 C 66 16, 76 28, 72 50 C 68 74, 52 80, 30 92"
          stroke="white" stroke-width="2.5" opacity="0.9" pathLength="100"
          vector-effect="non-scaling-stroke" stroke-linecap="round"
          class="vf-proc-pulse" />
  </svg>

  <!-- Nodes an den Step-Ankerpunkten -->
  <span class="vf-node" style="left:30%; top:8%;"></span>
  <span class="vf-node" style="left:72%; top:50%;"></span>
  <span class="vf-node" style="left:30%; top:92%;"></span>
</div>
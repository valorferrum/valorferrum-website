---
// src/components/Glints.astro
interface Props {
  density?: number;
  seed?: number;
}
const { density = 22, seed = 7 } = Astro.props;

// Deterministischer RNG → gleiche Verteilung bei jedem Build (kein Hydration-/CLS-Problem)
function mulberry32(a: number) {
  return function () {
    a |= 0; a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rnd = mulberry32(seed);

const sparkles = Array.from({ length: density }, () => ({
  left: +(rnd() * 100).toFixed(2),
  top: +(rnd() * 100).toFixed(2),
  size: +(2 + rnd() * 3.5).toFixed(1),
  delay: +(rnd() * 5).toFixed(2),
  dur: +(2.5 + rnd() * 3.5).toFixed(2),
}));

const prisms = Array.from({ length: Math.max(4, Math.round(density / 4)) }, () => ({
  left: +(rnd() * 100).toFixed(2),
  top: +(rnd() * 100).toFixed(2),
  rot: Math.round(rnd() * 180),
  delay: +(rnd() * 6).toFixed(2),
}));
---

<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
  {sparkles.map((s) => (
    <span
      class="vf-twinkle absolute rounded-full bg-white"
      style={`left:${s.left}%; top:${s.top}%; width:${s.size}px; height:${s.size}px; animation-duration:${s.dur}s; animation-delay:${s.delay}s; box-shadow:0 0 ${Math.round(s.size * 2.5)}px rgba(255,255,255,0.85);`}
    />
  ))}
  {prisms.map((p) => (
    <span
      class="vf-prism absolute"
      style={`left:${p.left}%; top:${p.top}%; transform:rotate(${p.rot}deg); animation-delay:${p.delay}s;`}
    />
  ))}
</div>
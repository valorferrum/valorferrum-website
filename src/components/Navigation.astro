---
const currentLocale = Astro.currentLocale || 'de';
const isDE = currentLocale === 'de';

const navLinks = [
  { href: isDE ? '/de/preise/' : '/en/pricing/', label: isDE ? 'Preise' : 'Pricing' },
  { href: `/${currentLocale}/blog/`, label: 'Blog' },
  { href: isDE ? '/de/ueber-mich/' : '/en/about/', label: isDE ? 'Über mich' : 'About' },
  { href: isDE ? '/de/kontakt/' : '/en/contact/', label: isDE ? 'Kontakt' : 'Contact' }
];

const serviceLinks = [
  { href: isDE ? '/de/leistungen/seo/': '/en/services/seo/' , label: 'SEO' },
  { href: isDE ? '/de/leistungen/sea/': '/en/services/sea/' , label: 'SEA' },
  { href: isDE ? '/de/leistungen/webentwicklung/': '/en/services/web-development/' , label: isDE ? 'Webentwicklung' : 'Web Development' },
  { href: isDE ? '/de/leistungen/tracking/': '/en/services/tracking/', label: 'Tracking' },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 transition-all duration-300" id="main-nav">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <a href={`/${currentLocale}/`} class="font-display text-2xl font-bold text-text-primary tracking-tight hover:opacity-90 transition-opacity">
        Valor<span class="text-primary">ferrum</span>
      </a>

      <!-- Desktop -->
      <div class="hidden md:flex items-center gap-8">
        <!-- Leistungen Dropdown -->
        <div class="relative group">
          <a href={isDE ? '/de/leistungen/' : '/en/services/'} class="text-sm font-medium text-text-secondary hover:text-primary transition-colors duration-200 relative py-2 flex items-center gap-1">
            {isDE ? 'Leistungen' : 'Services'}
            <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </a>
          <div class="absolute top-full left-0 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 translate-y-1 group-hover:translate-y-0">
            <div class="bg-surface/95 backdrop-blur-xl border border-border rounded-xl shadow-xl shadow-black/20 py-2 min-w-[200px]">
              {serviceLinks.map(link => (
                <a href={link.href} class="block px-4 py-2.5 text-sm text-text-secondary hover:text-primary hover:bg-surface-elevated transition-colors">
                  {link.label}
                </a>
              ))}
              <div class="border-t border-border mt-1 pt-1">
                <a href={isDE ? '/de/leistungen/' : '/en/services/'} class="block px-4 py-2.5 text-sm text-primary font-medium hover:bg-surface-elevated transition-colors">
                  {isDE ? 'Alle Leistungen →' : 'All Services →'}
                </a>
              </div>
            </div>
          </div>
        </div>

        {navLinks.map(link => (
          <a href={link.href} class="text-sm font-medium text-text-secondary hover:text-primary transition-colors duration-200 relative group">
            {link.label}
            <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-primary transition-all duration-300 group-hover:w-full"></span>
          </a>
        ))}
        <div class="flex items-center gap-2 pl-4 border-l border-border">
          <a href="/de/" class={`text-sm font-bold transition-colors ${isDE ? 'text-primary' : 'text-text-muted hover:text-text-secondary'}`}>DE</a>
          <span class="text-text-muted text-xs">/</span>
          <a href="/en/" class={`text-sm font-bold transition-colors ${!isDE ? 'text-primary' : 'text-text-muted hover:text-text-secondary'}`}>EN</a>
        </div>
      </div>

      <!-- Mobile Button -->
      <button id="mobile-menu-btn" class="md:hidden p-2 text-text-primary rounded-lg hover:bg-surface transition-colors" aria-label="Menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden absolute top-full left-0 right-0 bg-surface/95 backdrop-blur-xl border-b border-border">
    <div class="px-4 py-6 space-y-1">
      <!-- Mobile: Leistungen als ausklappbar -->
      <div class="space-y-1">
        <a href={isDE ? '/de/leistungen/' : '/en/services/'} class="block px-4 py-3 rounded-lg text-base font-medium text-text-secondary hover:text-primary hover:bg-surface-elevated transition-colors">
          {isDE ? 'Leistungen' : 'Services'}
        </a>
        <div class="pl-4 space-y-1 border-l-2 border-border ml-4">
          {serviceLinks.map(link => (
            <a href={link.href} class="block px-4 py-2 rounded-lg text-sm text-text-muted hover:text-primary hover:bg-surface-elevated transition-colors">
              {link.label}
            </a>
          ))}
        </div>
      </div>
      {navLinks.map(link => (
        <a href={link.href} class="block px-4 py-3 rounded-lg text-base font-medium text-text-secondary hover:text-primary hover:bg-surface-elevated transition-colors">
          {link.label}
        </a>
      ))}
      <div class="flex items-center gap-3 px-4 pt-4 border-t border-border mt-4">
        <a href="/de/" class={`text-sm font-bold ${isDE ? 'text-primary' : 'text-text-muted'}`}>DE</a>
        <span class="text-text-muted">/</span>
        <a href="/en/" class={`text-sm font-bold ${!isDE ? 'text-primary' : 'text-text-muted'}`}>EN</a>
      </div>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById('main-nav');
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  let isOpen = false;

  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      nav.classList.add('bg-bg/80', 'backdrop-blur-xl', 'border-b', 'border-border/50');
    } else {
      nav.classList.remove('bg-bg/80', 'backdrop-blur-xl', 'border-b', 'border-border/50');
    }
  });

  btn?.addEventListener('click', () => {
    isOpen = !isOpen;
    menu.classList.toggle('hidden');
    btn.style.transform = isOpen ? 'rotate(90deg)' : 'rotate(0deg)';
  });
</script>
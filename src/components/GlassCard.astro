---
/**
 * GlassCard – Rev 5.2
 * Glassmorphism + Gradient-Top-Border.
 * FIX: EmberParticles-Import entfernt (Komponente existiert nicht mehr).
 * Die `embers`-Prop wird jetzt durch einen reinen CSS-Effekt ersetzt.
 */

interface Props {
  href?: string;
  embers?: boolean;
  seed?: number;
  class?: string;
}

const { href, embers = false, seed = 5, class: className = '' } = Astro.props;

const Tag = href ? 'a' : 'div';
---

<Tag href={href} class={`glass group ${className}`}>
  {embers && <span class="css-embers" style={`animation-delay: -${seed}s;`} aria-hidden="true"></span>}
  <slot name="icon" />
  <slot />
</Tag>

<style>
  .glass {
    position: relative;
    display: block;
    height: 100%;
    background: rgba(20, 20, 27, 0.7);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 1rem;
    overflow: hidden;
    padding: 1.75rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .glass::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--color-spectrum-purple), var(--color-spectrum-pink));
    opacity: 0.9;
  }

  .glass:hover {
    transform: translateY(-4px);
    border-color: rgba(166, 92, 246, 0.25);
    box-shadow: 0 12px 40px -12px rgba(166, 92, 246, 0.25);
  }

  /* CSS-only Ember-Effekt (Ersatz für EmberParticles.astro) */
  .css-embers {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      radial-gradient(2px 2px at 18% 85%, rgba(251, 191, 36, 0.9), transparent 60%),
      radial-gradient(1.5px 1.5px at 42% 92%, rgba(249, 115, 22, 0.8), transparent 60%),
      radial-gradient(2px 2px at 66% 88%, rgba(251, 191, 36, 0.7), transparent 60%),
      radial-gradient(1.5px 1.5px at 85% 94%, rgba(236, 72, 153, 0.6), transparent 60%);
    background-repeat: no-repeat;
    opacity: 0.45;
    animation: emberRise 5s linear infinite;
  }

  @keyframes emberRise {
    0%   { background-position: 0 0, 0 0, 0 0, 0 0; opacity: 0; }
    15%  { opacity: 0.45; }
    100% { background-position: 12px -140px, -10px -160px, 8px -120px, -12px -150px; opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .glass:hover { transform: none; }
    .css-embers { animation: none; opacity: 0.2; }
  }
</style>
---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="Contact | Request Project | Valorferrum"
  description="Have a project? Contact me for SEO, SEA, web development or tracking setups. Response within 24 hours."
  lang="en"
>
  <section class="pt-32 pb-24 px-4">
    <div class="max-w-2xl mx-auto">
      <div class="text-center mb-12 reveal">
        <h1 class="font-display text-4xl md:text-5xl font-bold text-text-primary mb-6">Let's talk</h1>
        <p class="text-text-secondary text-lg">Have a project? Write me. No strings attached and honest. Response within 24 hours.</p>
      </div>

      <div class="reveal p-8 rounded-xl bg-surface border border-border mb-8">
        <form id="contact-form" class="space-y-6">
          <div>
            <label for="name" class="block text-sm font-medium text-text-secondary mb-2">Name</label>
            <input type="text" id="name" name="name" required class="w-full px-4 py-3 rounded-lg bg-bg border border-border text-text-primary focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="Your name" />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-text-secondary mb-2">Email</label>
            <input type="email" id="email" name="email" required class="w-full px-4 py-3 rounded-lg bg-bg border border-border text-text-primary focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="your@email.com" />
          </div>
          <div>
            <label for="service" class="block text-sm font-medium text-text-secondary mb-2">Service</label>
            <select id="service" name="service" class="w-full px-4 py-3 rounded-lg bg-bg border border-border text-text-primary focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all">
              <option value="">Please select</option>
              <option value="seo">SEO</option>
              <option value="sea">SEA & PPC</option>
              <option value="webdev">Web Development</option>
              <option value="tracking">Tracking & Analytics</option>
              <option value="consulting">Consulting / Workshop</option>
              <option value="other">Other</option>
            </select>
          </div>
          <div>
            <label for="message" class="block text-sm font-medium text-text-secondary mb-2">Message</label>
            <textarea id="message" name="message" rows="5" required class="w-full px-4 py-3 rounded-lg bg-bg border border-border text-text-primary focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all resize-none" placeholder="Describe your project..."></textarea>
          </div>
          
          <div id="form-status" class="hidden"></div>
          
          <button type="submit" id="submit-btn" class="w-full py-4 rounded-lg bg-gradient-to-r from-primary to-spectrum-pink text-white font-bold text-lg hover:brightness-110 transition-all shadow-lg shadow-primary/25">
            Send message
          </button>
        </form>
      </div>

      <div class="reveal text-center">
        <p class="text-text-muted text-sm">Or write me directly:</p>
        <a href="mailto:hello@valorferrum.de" class="text-primary hover:text-primary-light transition-colors font-medium">hello@valorferrum.de</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('contact-form');
  const statusDiv = document.getElementById('form-status');
  const submitBtn = document.getElementById('submit-btn');

  if (!form || !statusDiv || !submitBtn) {
    console.error('Form elements not found');
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending...';
    statusDiv.className = 'hidden';

    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: form.name.value,
          email: form.email.value,
          service: form.service.value,
          message: form.message.value
        })
      });

      const result = await response.json();

      if (response.ok) {
        statusDiv.className = 'p-4 rounded-lg bg-green-500/10 border border-green-500/20 text-green-400 text-sm';
        statusDiv.textContent = 'Message sent! I will get back to you within 24 hours.';
        form.reset();
      } else {
        statusDiv.className = 'p-4 rounded-lg bg-red-500/10 border border-red-500/20 text-red-400 text-sm';
        statusDiv.textContent = result.error || 'Something went wrong. Please try again.';
      }
    } catch (err) {
      console.error('Fetch error:', err);
      statusDiv.className = 'p-4 rounded-lg bg-red-500/10 border border-red-500/20 text-red-400 text-sm';
      statusDiv.textContent = 'Connection error. Please check your internet connection.';
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send message';
    }
  });
</script>
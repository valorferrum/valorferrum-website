---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="Services | SEO, SEA, Web Development & Tracking | Valorferrum"
  description="Performance marketing from a single source: SEO, SEA, web development and tracking. Value-driven, fair and measurable for SMEs, startups & NGOs."
  lang="en"
>
  <section class="pt-32 pb-24 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-16 reveal">
        <h1 class="font-display text-4xl md:text-5xl font-bold text-text-primary mb-6">Services</h1>
        <p class="text-text-secondary text-lg max-w-2xl mx-auto">Technical, strategic and data-driven. No sales pressure, no hidden agenda.</p>
      </div>

      <!-- Service Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
        <a href="/en/services/seo/" class="block reveal p-8 rounded-xl bg-surface border border-border hover:border-primary/30 transition-all group">
          <h3 class="font-display text-xl font-semibold text-text-primary mb-3 group-hover:text-primary transition-colors">SEO</h3>
          <p class="text-text-secondary text-sm mb-4">Technical optimization, content strategy & sustainable rankings. Onpage, offpage, local & e-commerce SEO.</p>
          <span class="text-primary text-sm font-medium group-hover:underline">Learn more →</span>
        </a>
        <a href="/en/services/sea/" class="block reveal p-8 rounded-xl bg-surface border border-border hover:border-spectrum-pink/30 transition-all group" style="transition-delay:100ms">
          <h3 class="font-display text-xl font-semibold text-text-primary mb-3 group-hover:text-spectrum-pink transition-colors">SEA & PPC</h3>
          <p class="text-text-secondary text-sm mb-4">Google Ads, Microsoft Ads, Meta, LinkedIn & more. Data-driven campaign optimization.</p>
          <span class="text-spectrum-pink text-sm font-medium group-hover:underline">Learn more →</span>
        </a>
        <a href="/en/services/web-development/" class="block reveal p-8 rounded-xl bg-surface border border-border hover:border-spectrum-blue/30 transition-all group" style="transition-delay:200ms">
          <h3 class="font-display text-xl font-semibold text-text-primary mb-3 group-hover:text-spectrum-blue transition-colors">Web Development</h3>
          <p class="text-text-secondary text-sm mb-4">Astro, WordPress, TYPO3. Performance-optimized websites that load and convert.</p>
          <span class="text-spectrum-blue text-sm font-medium group-hover:underline">Learn more →</span>
        </a>
        <a href="/en/services/tracking/" class="block reveal p-8 rounded-xl bg-surface border border-border hover:border-spectrum-yellow/30 transition-all group" style="transition-delay:300ms">
          <h3 class="font-display text-xl font-semibold text-text-primary mb-3 group-hover:text-spectrum-yellow transition-colors">Tracking & Analytics</h3>
          <p class="text-text-secondary text-sm mb-4">GA4, GTM, server-side tracking, BigQuery & Looker Studio. Privacy-compliant data strategy.</p>
          <span class="text-spectrum-yellow text-sm font-medium group-hover:underline">Learn more →</span>
        </a>
      </div>

      <!-- CTA -->
      <div class="reveal p-8 rounded-xl bg-gradient-to-br from-primary/10 to-spectrum-pink/10 border border-primary/20 text-center">
        <h3 class="font-display text-2xl font-bold text-text-primary mb-4">Pricing & Process</h3>
        <p class="text-text-secondary mb-6">Fixed price or hourly rate – you decide. No hidden costs, no surprises.</p>
        <a href="/en/pricing/" class="inline-flex items-center justify-center px-8 py-3 rounded-lg bg-primary text-white font-semibold hover:brightness-110 transition-all">View pricing</a>
      </div>
    </div>
  </section>
</Layout>
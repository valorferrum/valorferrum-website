---
import Layout from '../../../layouts/Layout.astro';
---

<Layout 
  title="Web Development & Website Creation | Valorferrum"
  description="Fast, accessible websites with Astro, React & WordPress. Built technically clean and search engine optimised. For SMEs, startups and NGOs."
  lang="en"
>
  <!-- ==================== HERO ==================== -->
  <section class="relative pt-32 pb-20 px-6 overflow-hidden">
    <div class="absolute top-1/4 right-1/4 w-96 h-96 bg-spectrum-blue/8 rounded-full blur-[120px] pulse-anim"></div>
    <div class="absolute bottom-1/4 left-1/4 w-80 h-80 bg-spectrum-purple/6 rounded-full blur-[100px] float-anim"></div>

    <div class="max-w-4xl mx-auto text-center relative">
      <div class="reveal mb-4">
        <a href="/en/services/" class="text-sm text-text-muted hover:text-primary transition-colors inline-flex items-center gap-1 group">
          <svg class="w-4 h-4 group-hover:-translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          All services
        </a>
      </div>

      <h1 class="reveal font-display text-4xl md:text-5xl lg:text-6xl font-bold text-text-primary mb-6 leading-tight" style="transition-delay: 100ms;">
        Web Development
      </h1>
      <p class="reveal text-text-secondary text-lg md:text-xl max-w-2xl mx-auto leading-relaxed" style="transition-delay: 200ms;">
        Websites that work. Fast, accessible, search engine optimised – 
        built with modern technologies that are maintainable and scalable.
      </p>
    </div>
  </section>

  <!-- ==================== TECH STACK ==================== -->
  <section class="pb-24 px-6" aria-labelledby="stack-heading">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <h2 id="stack-heading" class="reveal font-display text-2xl md:text-3xl font-bold text-text-primary mb-4">
          Astro, React, WordPress & More
        </h2>
        <p class="reveal text-text-secondary max-w-2xl mx-auto" style="transition-delay: 100ms;">
          The right technology for every project. I choose the stack that fits your goals – 
          not the one that is currently hyped.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <!-- Astro -->
        <div class="reveal card p-8 rounded-2xl bg-surface border border-border hover:border-primary/30 transition-all duration-500">
          <div class="w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          </div>
          <h3 class="font-display text-xl font-semibold text-text-primary mb-3">Astro</h3>
          <p class="text-text-secondary text-sm leading-relaxed mb-4">
            Static Site Generation with partial hydration. Perfect for fast, 
            SEO-optimised websites that don't need unnecessary JavaScript.
          </p>
          <ul class="text-text-secondary text-sm space-y-2">
            <li class="flex items-start gap-2"><span class="text-primary mt-0.5">→</span>Perfect Lighthouse scores & Core Web Vitals</li>
            <li class="flex items-start gap-2"><span class="text-primary mt-0.5">→</span>Islands Architecture for interactive components</li>
            <li class="flex items-start gap-2"><span class="text-primary mt-0.5">→</span>Content Collections for blogs & documentation</li>
          </ul>
        </div>

        <!-- React -->
        <div class="reveal card p-8 rounded-2xl bg-surface border border-border hover:border-spectrum-blue/30 transition-all duration-500" style="transition-delay: 100ms;">
          <div class="w-12 h-12 rounded-lg bg-spectrum-blue/10 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-spectrum-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
          </div>
          <h3 class="font-display text-xl font-semibold text-text-primary mb-3">React</h3>
          <p class="text-text-secondary text-sm leading-relaxed mb-4">
            For interactive web applications, dashboards and complex UIs. 
            I build with React 19, Next.js and TypeScript – type-safe and performant.
          </p>
          <ul class="text-text-secondary text-sm space-y-2">
            <li class="flex items-start gap-2"><span class="text-spectrum-blue mt-0.5">→</span>Next.js App Router & Server Components</li>
            <li class="flex items-start gap-2"><span class="text-spectrum-blue mt-0.5">→</span>TypeScript for type safety</li>
            <li class="flex items-start gap-2"><span class="text-spectrum-blue mt-0.5">→</span>TailwindCSS & shadcn/ui for rapid development</li>
          </ul>
        </div>

        <!-- WordPress -->
        <div class="reveal card p-8 rounded-2xl bg-surface border border-border hover:border-spectrum-pink/30 transition-all duration-500" style="transition-delay: 200ms;">
          <div class="w-12 h-12 rounded-lg bg-spectrum-pink/10 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-spectrum-pink" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
          </div>
          <h3 class="font-display text-xl font-semibold text-text-primary mb-3">WordPress</h3>
          <p class="text-text-secondary text-sm leading-relaxed mb-4">
            The classic for content-heavy websites. I build custom themes, 
            optimise for PageSpeed and integrate SEO plugins correctly.
          </p>
          <ul class="text-text-secondary text-sm space-y-2">
            <li class="flex items-start gap-2"><span class="text-spectrum-pink mt-0.5">→</span>Custom themes & child themes</li>
            <li class="flex items-start gap-2"><span class="text-spectrum-pink mt-0.5">→</span>Performance optimisation & caching</li>
            <li class="flex items-start gap-2"><span class="text-spectrum-pink mt-0.5">→</span>SEO plugin configuration (Yoast, RankMath)</li>
          </ul>
        </div>

        <!-- Jamstack & Headless -->
        <div class="reveal card p-8 rounded-2xl bg-surface border border-border hover:border-spectrum-yellow/30 transition-all duration-500" style="transition-delay: 300ms;">
          <div class="w-12 h-12 rounded-lg bg-spectrum-yellow/10 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-spectrum-yellow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path></svg>
          </div>
          <h3 class="font-display text-xl font-semibold text-text-primary mb-3">Jamstack & Headless</h3>
          <p class="text-text-secondary text-sm leading-relaxed mb-4">
            Decoupled frontends with headless CMS. I connect Contentful, 
            Sanity or Strapi with modern frontend frameworks.
          </p>
          <ul class="text-text-secondary text-sm space-y-2">
            <li class="flex items-start gap-2"><span class="text-spectrum-yellow mt-0.5">→</span>Headless CMS integration (Contentful, Sanity)</li>
            <li class="flex items-start gap-2"><span class="text-spectrum-yellow mt-0.5">→</span>Static site generation with dynamic content</li>
            <li class="flex items-start gap-2"><span class="text-spectrum-yellow mt-0.5">→</span>CDN deployment & edge functions</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== SERVICES ==================== -->
  <section class="py-24 px-6 bg-surface relative overflow-hidden" aria-labelledby="services-heading">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-gradient-to-b from-primary/5 to-transparent rounded-full blur-3xl"></div>

    <div class="max-w-5xl mx-auto relative">
      <div class="text-center mb-16">
        <h2 id="services-heading" class="reveal font-display text-2xl md:text-3xl font-bold text-text-primary mb-4">
          What I offer
        </h2>
        <p class="reveal text-text-secondary max-w-2xl mx-auto" style="transition-delay: 100ms;">
          From the first line of code to the live deployment. I build websites 
          that are technically clean, user-friendly and search engine optimised.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        <!-- Website Creation -->
        <div class="reveal p-8 rounded-2xl bg-bg/50 border border-border/50">
          <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
          </div>
          <h3 class="text-lg font-semibold text-text-primary mb-3 text-center">Website Creation</h3>
          <p class="text-text-secondary text-sm leading-relaxed text-center">
            From landing page to multi-page website. I design, develop and deploy – 
            with responsive design, accessibility and SEO from the start.
          </p>
        </div>

        <!-- Relaunch -->
        <div class="reveal p-8 rounded-2xl bg-bg/50 border border-border/50" style="transition-delay: 100ms;">
          <div class="w-14 h-14 rounded-xl bg-spectrum-blue/10 flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7 text-spectrum-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
          </div>
          <h3 class="text-lg font-semibold text-text-primary mb-3 text-center">Website Relaunch</h3>
          <p class="text-text-secondary text-sm leading-relaxed text-center">
            Old website, new technology. I migrate content, preserve SEO value 
            and improve performance – without losing rankings.
          </p>
        </div>

        <!-- Performance -->
        <div class="reveal p-8 rounded-2xl bg-bg/50 border border-border/50" style="transition-delay: 200ms;">
          <div class="w-14 h-14 rounded-xl bg-spectrum-pink/10 flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7 text-spectrum-pink" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          </div>
          <h3 class="text-lg font-semibold text-text-primary mb-3 text-center">Performance Optimisation</h3>
          <p class="text-text-secondary text-sm leading-relaxed text-center">
            Page speed, Core Web Vitals and Lighthouse scores. I identify bottlenecks 
            and optimise – for better user experience and Google rankings.
          </p>
        </div>

        <!-- Accessibility -->
        <div class="reveal p-8 rounded-2xl bg-bg/50 border border-border/50" style="transition-delay: 50ms;">
          <div class="w-14 h-14 rounded-xl bg-spectrum-yellow/10 flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7 text-spectrum-yellow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
          </div>
          <h3 class="text-lg font-semibold text-text-primary mb-3 text-center">Accessibility (a11y)</h3>
          <p class="text-text-secondary text-sm leading-relaxed text-center">
            Websites for everyone. I implement WCAG 2.1 AA standards – 
            for inclusive user experience and legal security.
          </p>
        </div>

        <!-- SEO Integration -->
        <div class="reveal p-8 rounded-2xl bg-bg/50 border border-border/50" style="transition-delay: 150ms;">
          <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
          </div>
          <h3 class="text-lg font-semibold text-text-primary mb-3 text-center">SEO Integration</h3>
          <p class="text-text-secondary text-sm leading-relaxed text-center">
            Clean HTML, semantic structure, meta tags and schema markup. 
            I build websites that Google understands from the start.
          </p>
        </div>

        <!-- Maintenance -->
        <div class="reveal p-8 rounded-2xl bg-bg/50 border border-border/50" style="transition-delay: 250ms;">
          <div class="w-14 h-14 rounded-xl bg-spectrum-blue/10 flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7 text-spectrum-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
          </div>
          <h3 class="text-lg font-semibold text-text-primary mb-3 text-center">Maintenance & Support</h3>
          <p class="text-text-secondary text-sm leading-relaxed text-center">
            Updates, backups, security patches and content changes. I keep your website 
            up to date – so you can focus on your business.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== WEB DEV KPIs ==================== -->
  <section class="py-24 px-6 bg-bg" aria-labelledby="kpis-heading">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <h2 id="kpis-heading" class="reveal font-display text-2xl md:text-3xl font-bold text-text-primary mb-4">
          Web Development KPIs
        </h2>
        <p class="reveal text-text-secondary max-w-2xl mx-auto" style="transition-delay: 100ms;">
          A good website is measurable. I optimise for metrics that 
          affect both user experience and Google rankings.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <div class="reveal p-6 rounded-xl bg-surface border border-border">
          <div class="text-primary font-display font-bold text-2xl mb-2">Lighthouse</div>
          <div class="text-text-primary font-semibold mb-1">Performance score</div>
          <p class="text-text-secondary text-sm">Target: 90+ in all categories (Performance, Accessibility, Best Practices, SEO).</p>
        </div>
        <div class="reveal p-6 rounded-xl bg-surface border border-border" style="transition-delay: 50ms;">
          <div class="text-primary font-display font-bold text-2xl mb-2">Core Web Vitals</div>
          <div class="text-text-primary font-semibold mb-1">Page experience</div>
          <p class="text-text-secondary text-sm">LCP under 2.5s, FID under 100ms, CLS under 0.1 – Google's ranking factors.</p>
        </div>
        <div class="reveal p-6 rounded-xl bg-surface border border-border" style="transition-delay: 100ms;">
          <div class="text-primary font-display font-bold text-2xl mb-2">Time to Interactive</div>
          <div class="text-text-primary font-semibold mb-1">Interactivity</div>
          <p class="text-text-secondary text-sm">How quickly can users interact? I optimise for TTI under 3.8 seconds.</p>
        </div>
        <div class="reveal p-6 rounded-xl bg-surface border border-border" style="transition-delay: 150ms;">
          <div class="text-primary font-display font-bold text-2xl mb-2">Bundle Size</div>
          <div class="text-text-primary font-semibold mb-1">JavaScript payload</div>
          <p class="text-text-secondary text-sm">Less is more. I keep JS bundles small through code splitting and tree shaking.</p>
        </div>
        <div class="reveal p-6 rounded-xl bg-surface border border-border" style="transition-delay: 200ms;">
          <div class="text-primary font-display font-bold text-2xl mb-2">Accessibility</div>
          <div class="text-text-primary font-semibold mb-1">WCAG compliance</div>
          <p class="text-text-secondary text-sm">WCAG 2.1 AA as standard. Screen reader compatible, keyboard navigable, colour contrast compliant.</p>
        </div>
        <div class="reveal p-6 rounded-xl bg-surface border border-border" style="transition-delay: 250ms;">
          <div class="text-primary font-display font-bold text-2xl mb-2">SEO Score</div>
          <div class="text-text-primary font-semibold mb-1">Technical SEO</div>
          <p class="text-text-secondary text-sm">Clean HTML, semantic structure, meta tags, schema markup and crawlability from the start.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== PROCESS ==================== -->
  <section class="py-24 px-6 bg-surface" aria-labelledby="process-heading">
    <div class="max-w-5xl mx-auto">
      <div class="mb-12">
        <h2 id="process-heading" class="reveal font-display text-2xl md:text-3xl font-bold text-text-primary mb-4">
          Development Process: From concept to go-live
        </h2>
        <p class="reveal text-text-secondary max-w-2xl" style="transition-delay: 100ms;">
          Transparent, iterative, measurable. I involve you in every step – 
          so the result matches your expectations.
        </p>
      </div>

      <div class="space-y-6">
        <div class="reveal flex gap-6 p-6 rounded-xl bg-bg border border-border/50 hover:border-primary/20 transition-colors">
          <div class="text-3xl font-display font-bold text-primary/40 shrink-0 w-12">01</div>
          <div>
            <h3 class="text-lg font-semibold text-text-primary mb-2">Discovery & Concept</h3>
            <p class="text-text-secondary text-sm leading-relaxed">
              Goals, target audience, content and functionality. I create a concept 
              that covers both business requirements and technical feasibility.
            </p>
          </div>
        </div>
        <div class="reveal flex gap-6 p-6 rounded-xl bg-bg border border-border/50 hover:border-primary/20 transition-colors" style="transition-delay: 100ms;">
          <div class="text-3xl font-display font-bold text-primary/40 shrink-0 w-12">02</div>
          <div>
            <h3 class="text-lg font-semibold text-text-primary mb-2">Design & Prototyping</h3>
            <p class="text-text-secondary text-sm leading-relaxed">
              Wireframes, design system and interactive prototypes. 
              You see the result before a single line of code is written.
            </p>
          </div>
        </div>
        <div class="reveal flex gap-6 p-6 rounded-xl bg-bg border border-border/50 hover:border-primary/20 transition-colors" style="transition-delay: 200ms;">
          <div class="text-3xl font-display font-bold text-primary/40 shrink-0 w-12">03</div>
          <div>
            <h3 class="text-lg font-semibold text-text-primary mb-2">Development & Testing</h3>
            <p class="text-text-secondary text-sm leading-relaxed">
              Clean code, component-based development and continuous testing. 
              I build with accessibility, performance and SEO from the start.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== CTA ==================== -->
  <section class="py-24 px-6 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-spectrum-blue/15 via-spectrum-purple/10 to-spectrum-pink/15"></div>
    <div class="max-w-3xl mx-auto text-center relative">
      <p class="reveal text-lg text-text-secondary mb-8 leading-relaxed">
        Whether new website, relaunch or performance optimisation: 
        Let's find out in a free initial consultation what your project needs.
      </p>
      <div class="reveal flex flex-col sm:flex-row gap-4 justify-center" style="transition-delay: 100ms;">
        <a href="/en/contact/" class="px-8 py-4 bg-primary hover:bg-primary-light text-white font-semibold rounded-lg transition-all duration-300 shadow-lg shadow-primary/25 hover:shadow-primary/40 hover:-translate-y-0.5 active:translate-y-0">
          Free initial consultation
        </a>
        <a href="/en/pricing/" class="px-8 py-4 border border-primary/30 hover:border-primary text-primary hover:text-primary-light rounded-lg transition-all duration-300 hover:bg-primary/5">
          Pricing & packages
        </a>
      </div>
    </div>
  </section>
</Layout>

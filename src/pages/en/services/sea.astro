---
import Layout from '../../../layouts/Layout.astro';
import SeaAdGlow from '../../../components/SeaAdGlow.tsx';

const meta = {
  title: "SEA Freelancer – Google Ads & PPC | Valorferrum",
  description: "Google Ads, Microsoft Ads & PPC campaigns with measurable return. Data-driven, transparent, without agency overhead – for SMEs, startups and NGOs.",
};
---

<Layout title={meta.title} description={meta.description} lang="en">
  <section class="relative" aria-label="SEA Hero">
    <SeaAdGlow client:visible lang="en" />
  </section>

  <!-- ==================== PLATFORMS ==================== -->
  <section class="pb-24 px-6" aria-labelledby="platforms-heading">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <h2 id="platforms-heading" class="reveal font-display text-2xl md:text-3xl font-bold text-text-primary mb-4">
          Google Ads, Microsoft Ads & Social Ads
        </h2>
        <p class="reveal text-text-secondary max-w-2xl mx-auto" style="transition-delay: 100ms;">
          Every platform has its strengths. I advertise where your target audience actually is – not everywhere.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6 mb-12">
        <!-- Google Ads -->
        <div class="reveal card p-8 rounded-2xl bg-surface border border-border hover:border-primary/30 transition-all duration-500">
          <div class="w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
          </div>
          <h3 class="font-display text-xl font-semibold text-text-primary mb-3">Google Ads Campaigns</h3>
          <p class="text-text-secondary text-sm leading-relaxed mb-4">
            Search, Display, Shopping and Performance Max. From keyword strategy to negative lists to bid management – I build structures that scale.
          </p>
          <ul class="text-text-secondary text-sm space-y-2">
            <li class="flex items-start gap-2"><span class="text-primary mt-0.5">→</span>Search campaigns with intent focus</li>
            <li class="flex items-start gap-2"><span class="text-primary mt-0.5">→</span>Shopping & Performance Max</li>
            <li class="flex items-start gap-2"><span class="text-primary mt-0.5">→</span>YouTube & Display remarketing</li>
          </ul>
        </div>

        <!-- Microsoft Ads -->
        <div class="reveal card p-8 rounded-2xl bg-surface border border-border hover:border-spectrum-pink/30 transition-all duration-500" style="transition-delay: 100ms;">
          <div class="w-12 h-12 rounded-lg bg-spectrum-pink/10 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-spectrum-pink" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
          </div>
          <h3 class="font-display text-xl font-semibold text-text-primary mb-3">Microsoft Ads</h3>
          <p class="text-text-secondary text-sm leading-relaxed mb-4">
            The underrated PPC network. Lower CPCs, LinkedIn targeting for B2B and an older, more affluent audience. Often the most profitable addition to Google.
          </p>
          <ul class="text-text-secondary text-sm space-y-2">
            <li class="flex items-start gap-2"><span class="text-spectrum-pink mt-0.5">→</span>B2B targeting via LinkedIn profiles</li>
            <li class="flex items-start gap-2"><span class="text-spectrum-pink mt-0.5">→</span>Lower competition density</li>
            <li class="flex items-start gap-2"><span class="text-spectrum-pink mt-0.5">→</span>Import & synergies with Google Ads</li>
          </ul>
        </div>

        <!-- Social Ads -->
        <div class="reveal card p-8 rounded-2xl bg-surface border border-border hover:border-spectrum-blue/30 transition-all duration-500" style="transition-delay: 200ms;">
          <div class="w-12 h-12 rounded-lg bg-spectrum-blue/10 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-spectrum-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
          </div>
          <h3 class="font-display text-xl font-semibold text-text-primary mb-3">Social Ads</h3>
          <p class="text-text-secondary text-sm leading-relaxed mb-4">
            Meta, LinkedIn and other networks. Not every target audience searches actively – some you have to find. I build funnels that turn interest into action.
          </p>
          <ul class="text-text-secondary text-sm space-y-2">
            <li class="flex items-start gap-2"><span class="text-spectrum-blue mt-0.5">→</span>Meta Ads (Facebook & Instagram)</li>
            <li class="flex items-start gap-2"><span class="text-spectrum-blue mt-0.5">→</span>LinkedIn Ads for B2B lead gen</li>
            <li class="flex items-start gap-2"><span class="text-spectrum-blue mt-0.5">→</span>Lookalike & custom audiences</li>
          </ul>
        </div>

        <!-- Display Ads & Retargeting -->
        <div class="reveal card p-8 rounded-2xl bg-surface border border-border hover:border-spectrum-yellow/30 transition-all duration-500" style="transition-delay: 300ms;">
          <div class="w-12 h-12 rounded-lg bg-spectrum-yellow/10 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-spectrum-yellow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
          </div>
          <h3 class="font-display text-xl font-semibold text-text-primary mb-3">Display Ads & Retargeting</h3>
          <p class="text-text-secondary text-sm leading-relaxed mb-4">
            Advertising for people who already know your website. Display networks, remarketing lists and dynamic ads – for the second and third touch.
          </p>
          <ul class="text-text-secondary text-sm space-y-2">
            <li class="flex items-start gap-2"><span class="text-spectrum-yellow mt-0.5">→</span>Remarketing lists & segments</li>
            <li class="flex items-start gap-2"><span class="text-spectrum-yellow mt-0.5">→</span>Dynamic display ads</li>
            <li class="flex items-start gap-2"><span class="text-spectrum-yellow mt-0.5">→</span>Google Display Network & partners</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== CAMPAIGN GOALS ==================== -->
  <section class="py-24 px-6 bg-surface relative overflow-hidden" aria-labelledby="goals-heading">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-gradient-to-b from-spectrum-pink/5 to-transparent rounded-full blur-3xl"></div>

    <div class="max-w-5xl mx-auto relative">
      <div class="text-center mb-16">
        <h2 id="goals-heading" class="reveal font-display text-2xl md:text-3xl font-bold text-text-primary mb-4">
          SEA Campaigns: The Right Strategy for Every Goal
        </h2>
        <p class="reveal text-text-secondary max-w-2xl mx-auto" style="transition-delay: 100ms;">
          Not every campaign has to sell immediately. Sometimes you need reach, sometimes leads, sometimes direct revenue. I choose the setup accordingly.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        <!-- Awareness -->
        <div class="reveal p-8 rounded-2xl bg-bg/50 border border-border/50 text-center">
          <div class="w-14 h-14 rounded-xl bg-spectrum-purple/10 flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7 text-spectrum-purple" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"></path></svg>
          </div>
          <h3 class="text-lg font-semibold text-text-primary mb-3">Awareness & Branding</h3>
          <p class="text-text-secondary text-sm leading-relaxed">
            Make your brand visible before the search begins. Display, video and social ads for reach, recognition and brand awareness.
          </p>
        </div>

        <!-- Lead Generation -->
        <div class="reveal p-8 rounded-2xl bg-bg/50 border border-border/50 text-center" style="transition-delay: 100ms;">
          <div class="w-14 h-14 rounded-xl bg-spectrum-pink/10 flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7 text-spectrum-pink" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
          </div>
          <h3 class="text-lg font-semibold text-text-primary mb-3">Lead Generation</h3>
          <p class="text-text-secondary text-sm leading-relaxed">
            Forms, downloads, demo requests. I build funnels that turn interest into qualified contacts – with tracking that attributes every source.
          </p>
        </div>

        <!-- Revenue -->
        <div class="reveal p-8 rounded-2xl bg-bg/50 border border-border/50 text-center" style="transition-delay: 200ms;">
          <div class="w-14 h-14 rounded-xl bg-spectrum-blue/10 flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7 text-spectrum-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <h3 class="text-lg font-semibold text-text-primary mb-3">Revenue & E-Commerce</h3>
          <p class="text-text-secondary text-sm leading-relaxed">
            Direct sales, shopping carts, bookings. Shopping campaigns, dynamic remarketing and conversion-optimized landing pages for maximum ROAS.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== KPIs ==================== -->
  <section class="py-24 px-6 bg-bg" aria-labelledby="kpis-heading">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <h2 id="kpis-heading" class="reveal font-display text-2xl md:text-3xl font-bold text-text-primary mb-4">
          SEA Reporting & PPC KPIs
        </h2>
        <p class="reveal text-text-secondary max-w-2xl mx-auto" style="transition-delay: 100ms;">
          I don't optimize for clicks. I optimize for the numbers that move your business forward.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <div class="reveal p-6 rounded-xl bg-surface border border-border">
          <div class="text-primary font-display font-bold text-2xl mb-2">ROAS</div>
          <div class="text-text-primary font-semibold mb-1">Return on Ad Spend</div>
          <p class="text-text-secondary text-sm">Every euro spent must pay off. I measure and optimize against your individual profitability threshold.</p>
        </div>
        <div class="reveal p-6 rounded-xl bg-surface border border-border" style="transition-delay: 50ms;">
          <div class="text-primary font-display font-bold text-2xl mb-2">CPA</div>
          <div class="text-text-primary font-semibold mb-1">Cost per Acquisition</div>
          <p class="text-text-secondary text-sm">What does a lead, an inquiry, a sale cost? I lower this value through targeted targeting and optimization.</p>
        </div>
        <div class="reveal p-6 rounded-xl bg-surface border border-border" style="transition-delay: 100ms;">
          <div class="text-primary font-display font-bold text-2xl mb-2">CTR</div>
          <div class="text-text-primary font-semibold mb-1">Click-Through Rate</div>
          <p class="text-text-secondary text-sm">How relevant are your ads? High CTR means better quality scores – and lower cost per click.</p>
        </div>
        <div class="reveal p-6 rounded-xl bg-surface border border-border" style="transition-delay: 150ms;">
          <div class="text-primary font-display font-bold text-2xl mb-2">CVR</div>
          <div class="text-text-primary font-semibold mb-1">Conversion Rate</div>
          <p class="text-text-secondary text-sm">Traffic is worthless without conversion. I analyze where users drop off – and optimize landing pages and ads.</p>
        </div>
        <div class="reveal p-6 rounded-xl bg-surface border border-border" style="transition-delay: 200ms;">
          <div class="text-primary font-display font-bold text-2xl mb-2">Reach</div>
          <div class="text-text-primary font-semibold mb-1">Users Reached</div>
          <p class="text-text-secondary text-sm">How many potential customers see your ads? The foundation for awareness campaigns and brand recognition on social ads.</p>
        </div>
        <div class="reveal p-6 rounded-xl bg-surface border border-border" style="transition-delay: 250ms;">
          <div class="text-primary font-display font-bold text-2xl mb-2">IS</div>
          <div class="text-text-primary font-semibold mb-1">Impression Share</div>
          <p class="text-text-secondary text-sm">How often is your ad served compared to the competition? An indicator of budget efficiency and market share.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== SEA OPTIMIZATION / PROCESS ==================== -->
  <section class="py-24 px-6 bg-surface" aria-labelledby="process-heading">
    <div class="text-center mb-12">
      <div class="mb-12">
        <h2 id="process-heading" class="reveal font-display text-2xl md:text-3xl font-bold text-text-primary mb-4">
          SEA Optimization: Data-Driven, Not Gut Feeling
        </h2>
        <p class="reveal text-text-secondary max-w-2xl mx-auto" style="transition-delay: 100ms;">
          No set-and-forget. Campaigns thrive on continuous analysis, testing and adjustments.
        </p>
      </div>

      <div class="space-y-6">
        <div class="reveal flex gap-6 p-6 rounded-xl bg-bg border border-border/50 hover:border-primary/20 transition-colors">
          <div class="text-3xl font-display font-bold text-primary/40 shrink-0 w-12">01</div>
          <div>
            <h3 class="text-lg font-semibold text-text-primary mb-2">Audit & Analysis</h3>
            <p class="text-text-secondary text-sm leading-relaxed">
              Inventory of your current campaigns, competitive analysis and identification of the biggest levers. Where is budget being burned? Where is potential untapped?
            </p>
          </div>
        </div>
        <div class="reveal flex gap-6 p-6 rounded-xl bg-bg border border-border/50 hover:border-primary/20 transition-colors" style="transition-delay: 100ms;">
          <div class="text-3xl font-display font-bold text-primary/40 shrink-0 w-12">02</div>
          <div>
            <h3 class="text-lg font-semibold text-text-primary mb-2">Setup & Structure</h3>
            <p class="text-text-secondary text-sm leading-relaxed">
              Campaign architecture, keyword strategy, ad copy and conversion tracking. Solid foundations you can scale on.
            </p>
          </div>
        </div>
        <div class="reveal flex gap-6 p-6 rounded-xl bg-bg border border-border/50 hover:border-primary/20 transition-colors" style="transition-delay: 200ms;">
          <div class="text-3xl font-display font-bold text-primary/40 shrink-0 w-12">03</div>
          <div>
            <h3 class="text-lg font-semibold text-text-primary mb-2">Ongoing Optimization & Reporting</h3>
            <p class="text-text-secondary text-sm leading-relaxed">
              A/B tests, bid adjustments, negative list maintenance and budget shifts. Transparent reporting that shows which euro brought what.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== CTA ==================== -->
  <section class="py-24 px-6 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-spectrum-pink/15 via-spectrum-purple/10 to-spectrum-blue/15"></div>
    <div class="max-w-3xl mx-auto text-center relative">
      <p class="reveal text-lg text-text-secondary mb-8 leading-relaxed">
        Whether a fresh start or optimization of existing campaigns: Let's find out in a free initial consultation where your biggest potential lies.
      </p>
      <div class="reveal flex flex-col sm:flex-row gap-4 justify-center" style="transition-delay: 100ms;">
        <a href="/en/contact/" class="px-8 py-4 bg-primary hover:bg-primary-light text-white font-semibold rounded-lg transition-all duration-300 shadow-lg shadow-primary/25 hover:shadow-primary/40 hover:-translate-y-0.5 active:translate-y-0">
          Free Initial Consultation
        </a>
        <a href="/en/pricing/" class="px-8 py-4 border border-primary/30 hover:border-primary text-primary hover:text-primary-light rounded-lg transition-all duration-300 hover:bg-primary/5">
          Prices & Packages
        </a>
      </div>
    </div>
  </section>
</Layout>
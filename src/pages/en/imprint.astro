---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Imprint | Valorferrum"
  description="Imprint and legal information of Valorferrum."
  lang="en"
>
  <section class="pt-32 pb-24 px-4">
    <div class="max-w-3xl mx-auto">
      <h1 class="font-display text-4xl font-bold text-text-primary mb-8 reveal">Imprint</h1>
      <div class="reveal space-y-8 text-text-secondary">
        <div class="p-6 rounded-xl bg-surface border border-border">
          <h2 class="font-display text-xl font-semibold text-text-primary mb-4">Information according to § 5 TMG</h2>
          <p class="mb-2"><strong class="text-text-primary">[Owner Name]</strong></p>
          <p class="mb-2">Valorferrum</p>
          <p class="mb-2">[Street Number]</p>
          <p class="mb-2">[ZIP City]</p>
          <p class="mb-2">Germany</p>
        </div>
        <div class="p-6 rounded-xl bg-surface border border-border">
          <h2 class="font-display text-xl font-semibold text-text-primary mb-4">Contact</h2>
          <p class="mb-2">Phone: [Phone Number]</p>
          <p class="mb-2">Email: hello@valorferrum.de</p>
        </div>
        <div class="p-6 rounded-xl bg-surface border border-border">
          <h2 class="font-display text-xl font-semibold text-text-primary mb-4">VAT ID</h2>
          <p>VAT identification number according to §27 a VAT Act:</p>
          <p class="text-text-muted">[VAT ID]</p>
        </div>
        <div class="p-6 rounded-xl bg-surface border border-border">
          <h2 class="font-display text-xl font-semibold text-text-primary mb-4">Professional Liability Insurance</h2>
          <p>[Name and location of insurance]</p>
          <p class="text-text-muted">[Scope of insurance]</p>
        </div>
        <div class="p-6 rounded-xl bg-surface border border-border">
          <h2 class="font-display text-xl font-semibold text-text-primary mb-4">Note</h2>
          <p>This is a freelance sole proprietorship.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import RingRipple from '../../components/RingRipple';
import IronTilt from '../../components/IronTilt';
import CountUp from '../../components/CountUp';
import TechMarquee from '../../components/TechMarquee.astro';

const posts = (await getCollection('blog', (post) => post.data.lang === 'en'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Layout title="Valorferrum – Freelancer & Consultant for SEO, SEA & Web Development" lang="en">

  <!-- ==================== HERO ==================== -->
  <section class="hero section section--hero" aria-label="Hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="hero-glow-left" aria-hidden="true"></div>
    <div class="hero-glow-right" aria-hidden="true"></div>

    <div class="hero-sparks hero-sparks--left" aria-hidden="true">
      <i class="cloud-spark" style="--x:35%; --c:#EC4899; --d:-1s;   --dur:7s;"></i>
      <i class="cloud-spark" style="--x:55%; --c:#C49AFF; --d:-3.5s; --dur:8s;"></i>
      <i class="cloud-spark" style="--x:45%; --c:#A65CF6; --d:-6s;   --dur:6.5s;"></i>
      <i class="cloud-spark" style="--x:65%; --c:#F0E1FF; --d:-2.5s; --dur:9s;"></i>
    </div>
    <div class="hero-sparks hero-sparks--right" aria-hidden="true">
      <i class="cloud-spark" style="--x:40%; --c:#C49AFF; --d:-2s;   --dur:7.5s;"></i>
      <i class="cloud-spark" style="--x:60%; --c:#EC4899; --d:-5s;   --dur:8.5s;"></i>
      <i class="cloud-spark" style="--x:50%; --c:#A65CF6; --d:-7s;   --dur:6.5s;"></i>
    </div>

    <div class="hero-content">
      <div class="hero-stage reveal mx-auto">

        <!-- Vorderer Feuerring -->
        <div class="hero-orbit" aria-hidden="true">
          <svg class="hoop-svg" viewBox="0 0 100 100" preserveAspectRatio="none" fill="none" overflow="visible">
            <defs>
              <linearGradient id="fireHoop-en" x1="0" y1="0" x2="100" y2="100" gradientUnits="userSpaceOnUse">
                <stop offset="0"   stop-color="#5c3578" stop-opacity="0.9"/>
                <stop offset="0.5" stop-color="#EC4899" stop-opacity="0.65"/>
                <stop offset="1"   stop-color="#3a2154" stop-opacity="0.9"/>
              </linearGradient>
            </defs>
            <ellipse class="fr-halo" cx="50" cy="50" rx="49" ry="49" pathLength="100" stroke="#A65CF6" stroke-width="26" vector-effect="non-scaling-stroke"/>
            <ellipse class="fr-mid" cx="50" cy="50" rx="49" ry="49" pathLength="100" stroke="#A65CF6" stroke-width="13" vector-effect="non-scaling-stroke"/>
            <ellipse class="fr-tube" cx="50" cy="50" rx="49" ry="49" pathLength="100" stroke="url(#fireHoop-en)" stroke-width="6" vector-effect="non-scaling-stroke"/>
            <ellipse class="fr-core" cx="50" cy="50" rx="49" ry="49" pathLength="100" stroke="#F5EBFF" stroke-width="1.75" vector-effect="non-scaling-stroke"/>
            <ellipse class="fire-swell" cx="50" cy="50" rx="49" ry="49" pathLength="100" stroke="#A65CF6" stroke-width="24" vector-effect="non-scaling-stroke" stroke-linecap="round"/>
            <ellipse class="fire-wave fire-wave--aura" cx="50" cy="50" rx="49" ry="49" pathLength="100" stroke="#EC4899" stroke-width="14" vector-effect="non-scaling-stroke" stroke-linecap="round"/>
            <ellipse class="fire-wave" cx="50" cy="50" rx="49" ry="49" pathLength="100" stroke="#F0E1FF" stroke-width="3.5" vector-effect="non-scaling-stroke" stroke-linecap="round"/>
            <ellipse class="fire-spark" cx="50" cy="50" rx="49" ry="49" pathLength="100" stroke="#FFFFFF" stroke-width="4" vector-effect="non-scaling-stroke" stroke-linecap="round"/>
          </svg>
        </div>

        <!-- Hinterer Feuerring -->
        <div class="hero-orbit hero-orbit--far" aria-hidden="true">
          <svg class="hoop-svg" viewBox="0 0 100 100" preserveAspectRatio="none" fill="none" overflow="visible">
            <ellipse class="fr-halo" cx="50" cy="50" rx="49" ry="49" pathLength="100" stroke="#7C3AED" stroke-width="20" vector-effect="non-scaling-stroke"/>
            <ellipse class="fr-mid" cx="50" cy="50" rx="49" ry="49" pathLength="100" stroke="#7C3AED" stroke-width="10" vector-effect="non-scaling-stroke"/>
            <ellipse class="fr-tube" cx="50" cy="50" rx="49" ry="49" pathLength="100" stroke="#3a2154" stroke-width="4" vector-effect="non-scaling-stroke"/>
            <ellipse class="fr-core" cx="50" cy="50" rx="49" ry="49" pathLength="100" stroke="#C49AFF" stroke-width="1.25" vector-effect="non-scaling-stroke"/>
            <ellipse class="fire-swell" cx="50" cy="50" rx="49" ry="49" pathLength="100" stroke="#7C3AED" stroke-width="18" vector-effect="non-scaling-stroke" stroke-linecap="round"/>
            <ellipse class="fire-wave fire-wave--aura" cx="50" cy="50" rx="49" ry="49" pathLength="100" stroke="#A65CF6" stroke-width="10" vector-effect="non-scaling-stroke" stroke-linecap="round"/>
            <ellipse class="fire-wave" cx="50" cy="50" rx="49" ry="49" pathLength="100" stroke="#C49AFF" stroke-width="2.5" vector-effect="non-scaling-stroke" stroke-linecap="round"/>
          </svg>
        </div>

        <!-- Der Schmelztiegel -->
        <div class="hero-ring">
          <RingRipple client:only="react" />
          <div class="ring-heat" aria-hidden="true"></div>
          <div class="ring-sheen" aria-hidden="true"></div>
          <div class="ring-embers" aria-hidden="true">
            <span class="ring-ember" style="--x:38%; --c:#EC4899; --d:0s;   --dur:6.5s;"></span>
            <span class="ring-ember" style="--x:56%; --c:#C49AFF; --d:2.2s; --dur:7.5s;"></span>
            <span class="ring-ember" style="--x:47%; --c:#A65CF6; --d:4.1s; --dur:6s;"></span>
          </div>
          <p class="eyebrow justify-center mb-4">SEO · SEA · Web Development · Tracking</p>
          <h1 class="text-4xl md:text-6xl font-display font-bold tracking-tighter mb-3">
            <span class="brush-accent brush-accent--xl">Valorferrum</span>
          </h1>
          <h2 class="text-lg md:text-2xl font-display font-semibold text-text-primary leading-tight mb-5">
            Your Freelancer &amp; Consultant<br /> for digital visibility
          </h2>
          <div class="brand-line mx-auto" aria-hidden="true"></div>
        </div>
      </div>

      <p class="reveal hero-claim">Digital visibility that lasts.<br />Performance that endures.</p>
      <p class="reveal hero-subclaim">Your success. My standard.</p>

      <div class="reveal hero-actions justify-center">
        <a href="/en/contact/" class="btn btn-primary">Book initial call</a>
        <a href="/en/services/" class="btn btn-secondary">Discover services</a>
      </div>
    </div>
  </section>

  <TechMarquee />

  <!-- ==================== SERVICES ==================== -->
  <section class="section section--soft" aria-labelledby="services-heading">
    <div class="ring-echo ring-echo--dashed" style="width:26rem;height:26rem;top:-9rem;right:-10rem;" aria-hidden="true"></div>
    <div class="section-inner">
      <header class="section-header text-center mx-auto">
        <p class="eyebrow justify-center">01 / Services</p>
        <h2 id="services-heading" class="section-title">Four disciplines. <span class="spectrum-text">One strategy.</span></h2>
        <p class="section-intro mx-auto">SEO, SEA, web development and tracking interlock. I optimise your visibility technically, content-wise and paid – and build the infrastructure that supports it all.</p>
      </header>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        <IronTilt href="/en/services/seo/" className="service-card group reveal" client:visible>
          <span class="service-card-num" aria-hidden="true">01</span>
          <div class="service-card-icon" aria-hidden="true"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg></div>
          <h3 class="service-card-title">SEO & Search Engine Optimisation</h3>
          <p class="service-card-text">Technical SEO, on-page and link building: I move your website up on Google – sustainably and data-driven.</p>
          <span class="service-cta">More about SEO <span aria-hidden="true">→</span></span>
        </IronTilt>

        <IronTilt href="/en/services/sea/" className="service-card group reveal" delay={80} client:visible>
          <span class="service-card-num" aria-hidden="true">02</span>
          <div class="service-card-icon" aria-hidden="true"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122" /></svg></div>
          <h3 class="service-card-title">SEA & Google Ads</h3>
          <p class="service-card-text">Google Ads & PPC that pays off: Campaign setup, keyword strategy and ongoing optimisation.</p>
          <span class="service-cta">More about SEA <span aria-hidden="true">→</span></span>
        </IronTilt>

        <IronTilt href="/en/services/web-development/" className="service-card group reveal" delay={160} client:visible>
          <span class="service-card-num" aria-hidden="true">03</span>
          <div class="service-card-icon" aria-hidden="true"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg></div>
          <h3 class="service-card-title">Web Development</h3>
          <p class="service-card-text">Get a website built with Astro, WordPress or TYPO3 – fast, accessible and with basic SEO setup.</p>
          <span class="service-cta">More about Web Development <span aria-hidden="true">→</span></span>
        </IronTilt>

        <IronTilt href="/en/services/tracking/" className="service-card group reveal" delay={240} client:visible>
          <span class="service-card-num" aria-hidden="true">04</span>
          <div class="service-card-icon" aria-hidden="true"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg></div>
          <h3 class="service-card-title">Tracking & Analytics</h3>
          <p class="service-card-text">GA4, Tag Manager and conversion tracking – GDPR-compliant. Incl. Website Tracking Check.</p>
          <span class="service-cta">More about Tracking <span aria-hidden="true">→</span></span>
        </IronTilt>
      </div>
    </div>
  </section>

  <!-- ==================== WHY VALORFERRUM ==================== -->
  <section class="section" aria-labelledby="usp-heading">
    <div class="glow-cloud glow-cloud--purple glow-cloud--float" style="width:34rem;height:34rem;top:-10rem;left:-12rem;" aria-hidden="true"></div>
    <div class="glow-cloud glow-cloud--blue" style="width:26rem;height:26rem;bottom:-8rem;right:-10rem;" aria-hidden="true"></div>
    <div class="section-inner">
      <header class="section-header text-center mx-auto">
        <p class="eyebrow justify-center">02 / Differentiation</p>
        <h2 id="usp-heading" class="section-title">One person. No disconnects. <span class="spectrum-text">Fair pricing.</span></h2>
        <p class="section-intro mx-auto">No silos, no communication chains, no hidden costs. I am a developer, marketer and analyst in one person.</p>
      </header>
      <div class="stat-band reveal">
        <div class="stat">
          <div class="stat-value"><CountUp to={110} suffix=" €" client:visible /></div>
          <div class="stat-label">/ hour</div>
          <h3>Transparent Pricing</h3>
          <p>Fairly calculated, not made up. Cost coverage + risk buffer.</p>
        </div>
        <div class="stat stat--hero">
          <div class="stat-value">1</div>
          <div class="stat-label">Point of Contact</div>
          <h3>No Agency Overhead</h3>
          <p>No office, no PM, no CEO. You pay for my time and expertise.</p>
        </div>
        <div class="stat">
          <div class="stat-value"><CountUp to={100} suffix="%" client:visible /></div>
          <div class="stat-label">Honesty</div>
          <h3>Realistic Goals</h3>
          <p>No "Page 1 in 3 months". We define achievable successes together.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== PROCESS ==================== -->
  <section class="section section--soft" aria-labelledby="process-heading">
    <div class="ring-echo ring-echo--dashed" style="width:26rem;height:26rem;top:-9rem;right:-10rem;" aria-hidden="true"></div>
    <div class="section-inner">
      <header class="section-header text-center mx-auto">
        <p class="eyebrow justify-center">03 / Process</p>
        <h2 id="process-heading" class="section-title">How we <span class="spectrum-text">work</span> together</h2>
      </header>
    </div>
    <div class="orbit-wrapper reveal">
      <svg class="orbit-path" viewBox="0 0 100 100" preserveAspectRatio="none" fill="none" aria-hidden="true">
        <defs>
          <linearGradient id="orbitStroke-en" x1="0" y1="0" x2="100" y2="0" gradientUnits="userSpaceOnUse">
            <stop offset="0"   stop-color="#C49AFF" stop-opacity="0.9"/>
            <stop offset="0.5" stop-color="#EC4899" stop-opacity="0.7"/>
            <stop offset="1"   stop-color="#A65CF6" stop-opacity="0.8"/>
          </linearGradient>
        </defs>
        <path class="orbit-halo" d="M 0 20 C 40 20, 60 80, 100 80" stroke="#8B5CF6" stroke-width="10" vector-effect="non-scaling-stroke"/>
        <path class="orbit-base" d="M 0 20 C 40 20, 60 80, 100 80" stroke="url(#orbitStroke-en)" stroke-width="2.5" vector-effect="non-scaling-stroke"/>
      </svg>
      <ol class="orbit-steps">
        <li class="orbit-step">
          <span class="orbit-node" style="--c:#C49AFF" aria-hidden="true"></span>
          <p class="mono-label">01</p>
          <h3>Analysis & Status Quo</h3>
          <p>I analyse your website, your current Google ranking and your competitors. Where do you stand – and where are the biggest levers?</p>
        </li>
        <li class="orbit-step">
          <span class="orbit-node" style="--c:#EC4899" aria-hidden="true"></span>
          <p class="mono-label">02</p>
          <h3>Strategy & Concept</h3>
          <p>Together we define goals, budget and timeline. Whether SEO relaunch, new Google Ads campaign or website project – the foundation decides.</p>
        </li>
        <li class="orbit-step">
          <span class="orbit-node" style="--c:#A65CF6" aria-hidden="true"></span>
          <p class="mono-label">03</p>
          <h3>Implementation & Optimisation</h3>
          <p>I implement, measure results and iterate. Data-driven, not gut feeling. Regular updates included.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ==================== ABOUT ==================== -->
  <section class="section" aria-labelledby="about-heading">
    <div class="section-inner max-w-5xl mx-auto flex flex-col md:flex-row items-center gap-12 md:gap-16">
      <div class="reveal relative shrink-0">
        <div class="iron-plaque">
          <span class="iron-plaque-mono" aria-hidden="true">VF</span>
          <span class="mono-label">Valor · Ferrum</span>
        </div>
      </div>
      <div class="reveal flex-1">
        <p class="eyebrow">04 / About</p>
        <h2 id="about-heading" class="section-title mb-6">The person behind <span class="brush-accent">Valorferrum</span></h2>
        <p class="text-text-secondary leading-relaxed mb-8 text-lg">I am the mind behind Valorferrum – no team, no excuses. As a freelancer, I combine agency experience with the efficiency of a one-person operation. Technically deep, marketing-strong, always data-driven.</p>
        <a href="/en/about/" class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-primary/30 hover:border-primary hover:bg-primary/5 text-primary hover:text-primary-light font-medium transition-all group">
          More about me <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== BLOG ==================== -->
  {posts.length > 0 && (
    <section class="section section--soft" aria-labelledby="blog-heading">
      <div class="section-inner">
        <header class="flex flex-col md:flex-row justify-between items-start md:items-end mb-12 gap-4">
          <div class="section-header mb-0">
            <p class="eyebrow">05 / Blog</p>
            <h2 id="blog-heading" class="section-title mb-2">Knowledge & <span class="spectrum-text">Insights</span></h2>
            <p class="section-intro">Practical insights into SEO, SEA and web development.</p>
          </div>
          <a href="/en/blog/" class="hidden md:block text-primary hover:text-primary-light font-medium transition-colors">All articles →</a>
        </header>
        <div class="blog-split reveal">
          <a href={`/en/blog/${posts[0].slug}/`} class="blog-feature group">
            <p class="mono-label">{new Date(posts[0].data.pubDate).toLocaleDateString('en-GB')}</p>
            <h3 class="blog-feature-title">{posts[0].data.title}</h3>
            <p>{posts[0].data.description}</p>
          </a>
          <div class="blog-list">
            {posts.slice(1).map((post) => (
              <a href={`/en/blog/${post.slug}/`} class="blog-row group">
                <div>
                  <p class="mono-label">{new Date(post.data.pubDate).toLocaleDateString('en-GB')}</p>
                  <h4 class="mt-1">{post.data.title}</h4>
                </div>
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            ))}
          </div>
        </div>
        <a href="/en/blog/" class="md:hidden mt-6 block text-primary hover:text-primary-light font-medium transition-colors">All articles →</a>
      </div>
    </section>
  )}

  <!-- ==================== CTA ==================== -->
  <section class="section section--cta" aria-labelledby="cta-heading">
    <div class="glow-cloud-wrap" style="width:30rem;height:30rem;top:-8rem;left:-10rem;">
      <div class="glow-cloud glow-cloud--purple glow-cloud--float"></div>
      <i class="cloud-spark" style="--x:35%; --c:#EC4899; --d:-2s; --dur:7s;"></i>
      <i class="cloud-spark" style="--x:60%; --c:#C49AFF; --d:-5s; --dur:8s;"></i>
    </div>
    <div class="ring-echo ring-echo--dashed" style="width:38rem;height:38rem;left:50%;top:50%;transform:translate(-50%,-50%);" aria-hidden="true"></div>
    <div class="section-inner max-w-3xl mx-auto text-center relative z-10">
      <p class="eyebrow justify-center">06 / Contact</p>
      <h2 id="cta-heading" class="section-title text-3xl md:text-5xl mb-6">
        Let's find out where your biggest <span class="brush-accent">lever</span> is.
      </h2>
      <p class="text-lg text-text-secondary mb-10 leading-relaxed max-w-2xl mx-auto">
        No sales pitch. An honest look at potential, effort and priorities – whether SEO optimisation, Google Ads or a new website.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-5">
        <a href="/en/contact/" class="btn btn-primary">Free initial consultation</a>
        <a href="/en/pricing/" class="btn btn-secondary">Pricing & packages</a>
      </div>
    </div>
  </section>

</Layout>
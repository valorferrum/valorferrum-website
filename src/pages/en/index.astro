---
import Layout from '../../layouts/Layout.astro';
import HeroAssembler from '../../components/HeroAssembler.tsx';
import { getCollection } from 'astro:content';

const lang = 'en';
const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(p => p.data.lang === 'en')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const meta = {
  title: "Valorferrum – Freelancer for Digital Visibility | SEO, SEA & Web Dev",
  description: "Your success. My standard. As a freelancer, I combine SEO, SEA, web development and tracking – from one source, without agency overhead.",
};
---

<Layout title={meta.title} description={meta.description} lang="en">
  <section class="relative" aria-label="Hero">
    <HeroAssembler client:visible lang="en" />
  </section>

  <!-- ==================== SERVICES ==================== -->
  <section class="py-24 px-6 bg-bg" aria-labelledby="services-heading">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <h2 id="services-heading" class="reveal text-3xl md:text-4xl font-display font-bold text-text-primary mb-4">
          Services
        </h2>
        <p class="reveal text-text-secondary max-w-2xl mx-auto" style="transition-delay: 100ms;">
          Four areas that work together. I optimise your visibility technically,
          content-wise and paid – and build the infrastructure that supports it all.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <!-- SEO -->
        <a href="/en/services/seo" class="reveal card group relative p-8 rounded-2xl bg-surface border border-border hover:border-primary/30 transition-all duration-500">
          <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-spectrum-purple/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative">
            <div class="w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center mb-6 group-hover:bg-primary/20 transition-colors">
              <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </div>
            <h3 class="text-xl font-display font-semibold text-text-primary mb-3 group-hover:text-primary transition-colors">SEO & Search Engine Optimisation</h3>
            <p class="text-text-secondary leading-relaxed mb-4">
              On-page optimisation, technical SEO and link building: I move your website up
              on Google – sustainably and data-driven.
            </p>
            <span class="text-primary text-sm font-medium flex items-center gap-2">
              More about SEO <span class="group-hover:translate-x-1 transition-transform">→</span>
            </span>
          </div>
        </a>

        <!-- SEA -->
        <a href="/en/services/sea" class="reveal card group relative p-8 rounded-2xl bg-surface border border-border hover:border-primary/30 transition-all duration-500" style="transition-delay: 100ms;">
          <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-spectrum-pink/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative">
            <div class="w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center mb-6 group-hover:bg-primary/20 transition-colors">
              <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"></path></svg>
            </div>
            <h3 class="text-xl font-display font-semibold text-text-primary mb-3 group-hover:text-primary transition-colors">SEA & Google Ads</h3>
            <p class="text-text-secondary leading-relaxed mb-4">
              Paid search advertising that pays off: campaign setup, keyword strategy
              and ongoing optimisation for maximum efficiency.
            </p>
            <span class="text-primary text-sm font-medium flex items-center gap-2">
              More about SEA <span class="group-hover:translate-x-1 transition-transform">→</span>
            </span>
          </div>
        </a>

        <!-- Web Development -->
        <a href="/en/services/web-development" class="reveal card group relative p-8 rounded-2xl bg-surface border border-border hover:border-primary/30 transition-all duration-500" style="transition-delay: 200ms;">
          <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-spectrum-blue/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative">
            <div class="w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center mb-6 group-hover:bg-primary/20 transition-colors">
              <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
            </div>
            <h3 class="text-xl font-display font-semibold text-text-primary mb-3 group-hover:text-primary transition-colors">Web Development</h3>
            <p class="text-text-secondary leading-relaxed mb-4">
              Fast, accessible websites with Astro, React or WordPress –
              built technically clean and search engine optimised.
            </p>
            <span class="text-primary text-sm font-medium flex items-center gap-2">
              More about web development <span class="group-hover:translate-x-1 transition-transform">→</span>
            </span>
          </div>
        </a>

        <!-- Tracking -->
        <a href="/en/services/tracking" class="reveal card group relative p-8 rounded-2xl bg-surface border border-border hover:border-primary/30 transition-all duration-500" style="transition-delay: 300ms;">
          <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-primary/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative">
            <div class="w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center mb-6 group-hover:bg-primary/20 transition-colors">
              <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
            </div>
            <h3 class="text-xl font-display font-semibold text-text-primary mb-3 group-hover:text-primary transition-colors">Tracking & Analytics</h3>
            <p class="text-text-secondary leading-relaxed mb-4">
              Google Tag Manager, conversion tracking and privacy-compliant web analytics:
              I build the infrastructure for data-driven decisions.
            </p>
            <span class="text-primary text-sm font-medium flex items-center gap-2">
              More about tracking <span class="group-hover:translate-x-1 transition-transform">→</span>
            </span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== WHY VALORFERRUM (3 USPs) ==================== -->
  <section class="py-24 px-6 bg-surface relative overflow-hidden" aria-labelledby="usp-heading">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-gradient-to-b from-primary/5 to-transparent rounded-full blur-3xl"></div>

    <div class="max-w-6xl mx-auto relative">
      <div class="text-center mb-16">
        <h2 id="usp-heading" class="reveal text-3xl md:text-4xl font-display font-bold text-text-primary mb-4">
          Why Valorferrum?
        </h2>
        <p class="reveal text-text-secondary max-w-2xl mx-auto" style="transition-delay: 100ms;">
          No silos, no communication chains, no hidden costs.
          I am developer, marketer and analyst in one person.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <!-- USP 1: Transparent Pricing -->
        <div class="reveal text-center p-6 rounded-2xl bg-bg/50 border border-border/50">
          <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <a href="/en/pricing" class="inline-block text-5xl font-display font-bold text-primary mb-2 hover:text-primary-light transition-colors">
            €110<span class="text-lg text-text-secondary font-normal">/h</span>
          </a>
          <h3 class="text-lg font-semibold text-text-primary mb-3">Transparent Pricing</h3>
          <p class="text-text-secondary text-sm leading-relaxed">
            Fairly calculated, not made up. Prices based on cost coverage with a small risk buffer.
          </p>
        </div>

        <!-- USP 2: No Agency Overhead -->
        <div class="reveal text-center p-6 rounded-2xl bg-bg/50 border border-border/50" style="transition-delay: 100ms;">
          <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
          </div>
          <div class="text-5xl font-display font-bold text-primary mb-2">1<span class="text-lg text-text-secondary font-normal"> person</span></div>
          <h3 class="text-lg font-semibold text-text-primary mb-3">No Agency Overhead</h3>
          <p class="text-text-secondary text-sm leading-relaxed">
            No office, no project manager, no management. You pay for one thing: my time and my know-how.
          </p>
        </div>

        <!-- USP 3: Realistic Goals -->
        <div class="reveal text-center p-6 rounded-2xl bg-bg/50 border border-border/50" style="transition-delay: 200ms;">
          <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <div class="text-5xl font-display font-bold text-primary mb-2">100<span class="text-lg text-text-secondary font-normal">% honest</span></div>
          <h3 class="text-lg font-semibold text-text-primary mb-3">Realistic Goals</h3>
          <p class="text-text-secondary text-sm leading-relaxed">
            No "page 1 in 3 months". I show you realistic results and formulate goals together with you.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== PROCESS ==================== -->
  <section class="py-24 px-6 bg-bg" aria-labelledby="process-heading">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-16">
        <h2 id="process-heading" class="reveal text-3xl md:text-4xl font-display font-bold text-text-primary mb-4">
          How we work together
        </h2>
        <p class="reveal text-text-secondary max-w-2xl mx-auto" style="transition-delay: 100ms;">
          No blind flying. Every step is comprehensible – from the first analysis to ongoing reporting.
        </p>
      </div>

      <div class="space-y-6">
        <div class="reveal flex gap-6 p-6 rounded-xl bg-surface border border-border hover:border-primary/20 transition-colors">
          <div class="text-3xl font-display font-bold text-primary/40 shrink-0 w-12">01</div>
          <div>
            <h3 class="text-lg font-semibold text-text-primary mb-2">Analysis & Status Quo</h3>
            <p class="text-text-secondary leading-relaxed">
              I analyse your website, your current Google ranking and your competitors.
              Where do you stand – and where are the biggest levers?
            </p>
          </div>
        </div>
        <div class="reveal flex gap-6 p-6 rounded-xl bg-surface border border-border hover:border-primary/20 transition-colors" style="transition-delay: 100ms;">
          <div class="text-3xl font-display font-bold text-primary/40 shrink-0 w-12">02</div>
          <div>
            <h3 class="text-lg font-semibold text-text-primary mb-2">Strategy & Concept</h3>
            <p class="text-text-secondary leading-relaxed">
              Together we define goals, budget and timeline. Whether SEO relaunch, new Google Ads campaign
              or website project – the foundation decides.
            </p>
          </div>
        </div>
        <div class="reveal flex gap-6 p-6 rounded-xl bg-surface border border-border hover:border-primary/20 transition-colors" style="transition-delay: 200ms;">
          <div class="text-3xl font-display font-bold text-primary/40 shrink-0 w-12">03</div>
          <div>
            <h3 class="text-lg font-semibold text-text-primary mb-2">Implementation & Optimisation</h3>
            <p class="text-text-secondary leading-relaxed">
              I implement, measure results and iterate. Data-driven, not gut feeling.
              Regular updates included.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== ABOUT TEASER ==================== -->
  <section class="py-24 px-6 bg-surface" aria-labelledby="about-heading">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center gap-12">
      <div class="reveal w-48 h-48 rounded-2xl bg-gradient-to-br from-primary via-spectrum-pink to-spectrum-blue shrink-0 flex items-center justify-center shadow-lg shadow-primary/20">
        <span class="text-6xl">👤</span>
      </div>
      <div>
        <h2 id="about-heading" class="reveal text-3xl md:text-4xl font-display font-bold text-text-primary mb-4">
          The person behind Valorferrum
        </h2>
        <p class="reveal text-text-secondary leading-relaxed mb-6" style="transition-delay: 100ms;">
          I am the mind behind Valorferrum – no team, no excuses.
          As a freelancer, I combine agency experience with the efficiency of a one-person operation.
          Technically deep, marketing-strong, always data-driven. My benchmark is your success,
          not my timesheet.
        </p>
        <a href="/en/about" class="reveal text-primary hover:text-primary-light font-medium flex items-center gap-2 transition-colors group" style="transition-delay: 200ms;">
          More about me <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== BLOG TEASER ==================== -->
  {posts.length > 0 && (
    <section class="py-24 px-6 bg-bg" aria-labelledby="blog-heading">
      <div class="max-w-6xl mx-auto">
        <div class="flex justify-between items-end mb-12">
          <div>
            <h2 id="blog-heading" class="reveal text-3xl md:text-4xl font-display font-bold text-text-primary mb-2">Knowledge & Insights</h2>
            <p class="reveal text-text-secondary" style="transition-delay: 100ms;">Practical insights into SEO, SEA and web development.</p>
          </div>
          <a href="/en/blog" class="hidden md:block text-primary hover:text-primary-light font-medium transition-colors">All articles →</a>
        </div>
        <div class="grid md:grid-cols-2 gap-6">
          {posts.map((post, i) => (
            <a href={`/en/blog/${post.slug.replace('en/', '')}`} class="reveal card group p-6 rounded-xl bg-surface border border-border hover:border-primary/30 transition-all duration-300" style={`transition-delay: ${(i + 1) * 100}ms;`}>
              <div class="text-sm text-primary mb-3">{new Date(post.data.pubDate).toLocaleDateString('en-GB')}</div>
              <h3 class="text-xl font-semibold text-text-primary mb-3 group-hover:text-primary transition-colors">{post.data.title}</h3>
              <p class="text-text-secondary text-sm line-clamp-2">{post.data.description}</p>
            </a>
          ))}
        </div>
        <a href="/en/blog" class="md:hidden mt-6 block text-primary hover:text-primary-light font-medium transition-colors">All articles →</a>
      </div>
    </section>
  )}

  <!-- ==================== CTA ==================== -->
  <section class="py-24 px-6 relative overflow-hidden" aria-labelledby="cta-heading">
    <div class="absolute inset-0 bg-gradient-to-br from-spectrum-purple/20 via-spectrum-pink/10 to-spectrum-blue/20"></div>
    <div class="max-w-3xl mx-auto text-center relative">
      <h2 id="cta-heading" class="reveal text-3xl md:text-5xl font-display font-bold text-text-primary mb-6">
        Your success. My benchmark.
      </h2>
      <p class="reveal text-lg text-text-secondary mb-8 leading-relaxed" style="transition-delay: 100ms;">
        Whether SEO optimisation, Google Ads or a new website:
        Let's find out in a free initial consultation where your biggest levers are.
      </p>
      <div class="reveal flex flex-col sm:flex-row gap-4 justify-center" style="transition-delay: 200ms;">
        <a href="/en/contact" class="px-8 py-4 bg-primary hover:bg-primary-light text-white font-semibold rounded-lg transition-all duration-300 shadow-lg shadow-primary/25 hover:shadow-primary/40 hover:-translate-y-0.5 active:translate-y-0">
          Free initial consultation
        </a>
        <a href="/en/pricing" class="px-8 py-4 border border-white/20 hover:border-primary text-text-primary hover:text-primary rounded-lg transition-all duration-300 hover:bg-primary/5">
          Pricing & packages
        </a>
      </div>
    </div>
  </section>
</Layout>

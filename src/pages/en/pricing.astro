---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Pricing | Valorferrum – SEO, SEA & Web Development Costs"
  description="Transparent pricing: €110/hour. 6 fixed-price packages from €990. No hidden costs, no agency overhead. For SMEs, startups and NGOs."
  lang="en"
>
  <section class="pt-32 pb-24 px-4">
    <div class="max-w-6xl mx-auto">
      <!-- Hero -->
      <div class="text-center mb-16 reveal">
        <h1 class="font-display text-4xl md:text-5xl font-bold text-text-primary mb-6">
          Pricing
        </h1>
        <p class="text-text-secondary text-lg max-w-2xl mx-auto leading-relaxed">
          Transparent, fair, calculated. No hidden costs, no surprises – just honest work at a fair price.
        </p>
      </div>

      <!-- Hourly Rate -->
      <div class="reveal p-8 rounded-xl bg-surface border border-border mb-16">
        <div class="flex flex-col md:flex-row items-center gap-8">
          <div class="text-center md:text-left">
            <div class="text-6xl font-display font-bold text-primary mb-2">€110<span class="text-2xl text-text-secondary font-normal">/hour</span></div>
            <p class="text-text-secondary">All services. One price. No hidden fees.</p>
          </div>
          <div class="flex-1 grid sm:grid-cols-3 gap-4">
            <div class="text-center p-4 rounded-lg bg-bg">
              <div class="text-primary font-bold text-lg mb-1">€92</div>
              <div class="text-text-secondary text-sm">Cost coverage</div>
            </div>
            <div class="text-center p-4 rounded-lg bg-bg">
              <div class="text-primary font-bold text-lg mb-1">€10</div>
              <div class="text-text-secondary text-sm">Quality buffer</div>
            </div>
            <div class="text-center p-4 rounded-lg bg-bg">
              <div class="text-primary font-bold text-lg mb-1">€8</div>
              <div class="text-text-secondary text-sm">Social buffer</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Packages -->
      <div class="mb-16">
        <h2 class="reveal font-display text-2xl md:text-3xl font-bold text-text-primary mb-8 text-center">Fixed-Price Packages</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- SEO Quick Win -->
          <div class="reveal p-6 rounded-xl bg-surface border border-border hover:border-primary/30 transition-all">
            <div class="text-sm text-primary font-medium mb-2">SEO</div>
            <h3 class="font-display text-xl font-semibold text-text-primary mb-2">SEO Quick-Win Analysis</h3>
            <div class="text-3xl font-display font-bold text-text-primary mb-4">€990</div>
            <ul class="text-text-secondary text-sm space-y-2 mb-6">
              <li class="flex items-start gap-2"><span class="text-primary">→</span>Technical SEO audit</li>
              <li class="flex items-start gap-2"><span class="text-primary">→</span>Top 5 quick wins identified</li>
              <li class="flex items-start gap-2"><span class="text-primary">→</span>Action plan with priorities</li>
              <li class="flex items-start gap-2"><span class="text-primary">→</span>8 hours of analysis</li>
            </ul>
            <a href="/en/contact" class="block text-center py-3 rounded-lg bg-primary/10 text-primary font-medium hover:bg-primary/20 transition-colors">Enquire now</a>
          </div>

          <!-- SEO Monthly -->
          <div class="reveal p-6 rounded-xl bg-surface border border-border hover:border-primary/30 transition-all" style="transition-delay: 100ms;">
            <div class="text-sm text-primary font-medium mb-2">SEO</div>
            <h3 class="font-display text-xl font-semibold text-text-primary mb-2">SEO Monthly Support</h3>
            <div class="text-3xl font-display font-bold text-text-primary mb-4">€2,200<span class="text-lg text-text-secondary font-normal">/month</span></div>
            <ul class="text-text-secondary text-sm space-y-2 mb-6">
              <li class="flex items-start gap-2"><span class="text-primary">→</span>On-page & content optimisation</li>
              <li class="flex items-start gap-2"><span class="text-primary">→</span>Technical monitoring</li>
              <li class="flex items-start gap-2"><span class="text-primary">→</span>Monthly reporting</li>
              <li class="flex items-start gap-2"><span class="text-primary">→</span>20 hours/month</li>
            </ul>
            <a href="/en/contact" class="block text-center py-3 rounded-lg bg-primary/10 text-primary font-medium hover:bg-primary/20 transition-colors">Enquire now</a>
          </div>

          <!-- Google Ads Setup -->
          <div class="reveal p-6 rounded-xl bg-surface border border-border hover:border-primary/30 transition-all" style="transition-delay: 200ms;">
            <div class="text-sm text-spectrum-pink font-medium mb-2">SEA</div>
            <h3 class="font-display text-xl font-semibold text-text-primary mb-2">Google Ads Setup</h3>
            <div class="text-3xl font-display font-bold text-text-primary mb-4">€1,650</div>
            <ul class="text-text-secondary text-sm space-y-2 mb-6">
              <li class="flex items-start gap-2"><span class="text-spectrum-pink">→</span>Campaign structure & setup</li>
              <li class="flex items-start gap-2"><span class="text-spectrum-pink">→</span>Conversion tracking</li>
              <li class="flex items-start gap-2"><span class="text-spectrum-pink">→</span>4 weeks optimisation</li>
              <li class="flex items-start gap-2"><span class="text-spectrum-pink">→</span>15 hours total</li>
            </ul>
            <a href="/en/contact" class="block text-center py-3 rounded-lg bg-primary/10 text-primary font-medium hover:bg-primary/20 transition-colors">Enquire now</a>
          </div>

          <!-- Website 5 Pages -->
          <div class="reveal p-6 rounded-xl bg-surface border border-border hover:border-primary/30 transition-all">
            <div class="text-sm text-spectrum-blue font-medium mb-2">Web Development</div>
            <h3 class="font-display text-xl font-semibold text-text-primary mb-2">Website (5 Pages)</h3>
            <div class="text-3xl font-display font-bold text-text-primary mb-4">€4,950</div>
            <ul class="text-text-secondary text-sm space-y-2 mb-6">
              <li class="flex items-start gap-2"><span class="text-spectrum-blue">→</span>Design & development</li>
              <li class="flex items-start gap-2"><span class="text-spectrum-blue">→</span>SEO basics included</li>
              <li class="flex items-start gap-2"><span class="text-spectrum-blue">→</span>Responsive & accessible</li>
              <li class="flex items-start gap-2"><span class="text-spectrum-blue">→</span>45 hours total</li>
            </ul>
            <a href="/en/contact" class="block text-center py-3 rounded-lg bg-primary/10 text-primary font-medium hover:bg-primary/20 transition-colors">Enquire now</a>
          </div>

          <!-- Website 10 Pages -->
          <div class="reveal p-6 rounded-xl bg-surface border border-border hover:border-primary/30 transition-all" style="transition-delay: 100ms;">
            <div class="text-sm text-spectrum-blue font-medium mb-2">Web Development</div>
            <h3 class="font-display text-xl font-semibold text-text-primary mb-2">Website (10 Pages)</h3>
            <div class="text-3xl font-display font-bold text-text-primary mb-4">€8,800</div>
            <ul class="text-text-secondary text-sm space-y-2 mb-6">
              <li class="flex items-start gap-2"><span class="text-spectrum-blue">→</span>Design & development</li>
              <li class="flex items-start gap-2"><span class="text-spectrum-blue">→</span>SEO basics included</li>
              <li class="flex items-start gap-2"><span class="text-spectrum-blue">→</span>CMS integration</li>
              <li class="flex items-start gap-2"><span class="text-spectrum-blue">→</span>80 hours total</li>
            </ul>
            <a href="/en/contact" class="block text-center py-3 rounded-lg bg-primary/10 text-primary font-medium hover:bg-primary/20 transition-colors">Enquire now</a>
          </div>

          <!-- Tracking Setup -->
          <div class="reveal p-6 rounded-xl bg-surface border border-border hover:border-primary/30 transition-all" style="transition-delay: 200ms;">
            <div class="text-sm text-spectrum-yellow font-medium mb-2">Tracking</div>
            <h3 class="font-display text-xl font-semibold text-text-primary mb-2">Tracking Setup</h3>
            <div class="text-3xl font-display font-bold text-text-primary mb-4">from €990</div>
            <ul class="text-text-secondary text-sm space-y-2 mb-6">
              <li class="flex items-start gap-2"><span class="text-spectrum-yellow">→</span>GA4 & GTM setup</li>
              <li class="flex items-start gap-2"><span class="text-spectrum-yellow">→</span>Conversion tracking</li>
              <li class="flex items-start gap-2"><span class="text-spectrum-yellow">→</span>Consent management</li>
              <li class="flex items-start gap-2"><span class="text-spectrum-yellow">→</span>from 8 hours</li>
            </ul>
            <a href="/en/contact" class="block text-center py-3 rounded-lg bg-primary/10 text-primary font-medium hover:bg-primary/20 transition-colors">Enquire now</a>
          </div>
        </div>
      </div>

      <!-- Fairness Principles -->
      <div class="reveal p-8 rounded-xl bg-surface border border-border">
        <h2 class="font-display text-2xl font-semibold text-text-primary mb-6 text-center">Fairness Principles</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <div>
              <h3 class="font-semibold text-text-primary mb-1">No hidden costs</h3>
              <p class="text-text-secondary text-sm">What we agree on is what you pay. No surprises, no extras without consultation.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <div>
              <h3 class="font-semibold text-text-primary mb-1">Fairly calculated</h3>
              <p class="text-text-secondary text-sm">€110/hour covers my costs plus a small buffer. No excess profit, no inflated agency rates.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
            </div>
            <div>
              <h3 class="font-semibold text-text-primary mb-1">Flexible terms</h3>
              <p class="text-text-secondary text-sm">Monthly contracts can be cancelled at any time. For long-term projects: minimum 3 months, then monthly.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
            </div>
            <div>
              <h3 class="font-semibold text-text-primary mb-1">Risk buffer for uncertain projects</h3>
              <p class="text-text-secondary text-sm">For unclear scopes: +10% risk surcharge. For retainers: no surcharge, minimum 3 months.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (post) => post.data.lang === 'de');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
// Wir stellen sicher, dass der Content wirklich gerendert wird
const { Content } = await post.render();
---

<Layout 
  title={`${post.data.title} - Valorferrum`} 
  description={post.data.description} 
  lang={post.data.lang}
>
  <article class="pt-32 pb-24 px-4">
    <div class="max-w-3xl mx-auto">
      <!-- Header Bereich -->
      <header class="mb-12 reveal">
        <a href="/de/blog/" class="text-sm text-text-muted hover:text-primary transition-colors mb-6 inline-flex items-center gap-1">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          Zurück zum Blog
        </a>
        
        <div class="flex flex-wrap gap-2 mb-6">
          {post.data.tags.map(tag => (
            <span class="px-3 py-1 rounded-full bg-primary/10 text-primary text-sm font-medium">{tag}</span>
          ))}
        </div>

        <h1 class="font-display text-4xl md:text-5xl font-bold text-text-primary mb-6">{post.data.title}</h1>
        
        <p class="text-xl text-text-secondary mb-4">{post.data.description}</p>
        
        <div class="flex items-center gap-4 text-sm text-text-muted">
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' })}
          </time>
          <span>•</span>
          <span>{post.data.author}</span>
        </div>
      </header>

      <!-- HIER IST DER WICHTIGE TEIL: Der eigentliche Inhalt -->
      <div class="prose prose-invert max-w-none">
        <Content />
      </div>
    </div>
  </article>
</Layout>
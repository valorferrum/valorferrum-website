---
import Layout from '../../../layouts/Layout.astro';
import IronTilt from '../../../components/IronTilt.tsx';
import FireHoop from '../../../components/FireHoop.astro';

const meta = {
  title: "SEA Freelancer – Google Werbung & PPC | Valorferrum",
  description: "Google Ads, Microsoft Ads & PPC-Kampagnen mit messbarem Return. Datengetrieben, transparent, ohne Agentur-Overhead – für KMU, Startups und NGOs.",
};
---

<Layout title={meta.title} description={meta.description} lang="de">

  <!-- ==================== SUBHERO (EINHEITLICH) ==================== -->
  <section class="section subhero" aria-labelledby="sea-heading">
    <div class="glow-cloud-wrap" style="width:30rem;height:30rem;top:-6rem;left:-10rem;">
      <div class="glow-cloud glow-cloud--purple glow-cloud--float"></div>
      <i class="cloud-spark" style="--x:40%; --c:#EC4899; --d:-2s; --dur:7s;"></i>
      <i class="cloud-spark" style="--x:60%; --c:#C49AFF; --d:-5s; --dur:8s;"></i>
    </div>
    <div class="glow-cloud-wrap" style="width:26rem;height:26rem;bottom:-8rem;right:-8rem;">
      <div class="glow-cloud glow-cloud--pink"></div>
      <i class="cloud-spark" style="--x:45%; --c:#A65CF6; --d:-3s; --dur:7.5s;"></i>
    </div>
    <FireHoop uid="sea-sub" cool tilt style="width:46rem; top:-16rem; right:-20rem;" />

    <div class="subhero-stage" aria-hidden="true">
      <div class="hero-stage">
        <div class="hero-orbit">
          <svg class="hoop-svg" viewBox="0 0 100 100" preserveAspectRatio="none" fill="none" overflow="visible">
            <defs>
              <linearGradient id="fireHoopSea" x1="0" y1="0" x2="100" y2="100" gradientUnits="userSpaceOnUse">
                <stop offset="0"   stop-color="#5c3578" stop-opacity="0.9"/>
                <stop offset="0.5" stop-color="#EC4899" stop-opacity="0.65"/>
                <stop offset="1"   stop-color="#3a2154" stop-opacity="0.9"/>
              </linearGradient>
            </defs>
            <ellipse class="fr-halo" cx="50" cy="50" rx="49" ry="49" stroke="#A65CF6" stroke-width="18" vector-effect="non-scaling-stroke"/>
            <ellipse class="fr-mid" cx="50" cy="50" rx="49" ry="49" stroke="#A65CF6" stroke-width="9" vector-effect="non-scaling-stroke"/>
            <ellipse class="fr-tube" cx="50" cy="50" rx="49" ry="49" stroke="url(#fireHoopSea)" stroke-width="5" vector-effect="non-scaling-stroke"/>
            <ellipse class="fr-core" cx="50" cy="50" rx="49" ry="49" stroke="#F5EBFF" stroke-width="1.5" vector-effect="non-scaling-stroke"/>
            <ellipse class="fire-swell" cx="50" cy="50" rx="49" ry="49" pathLength="100" stroke="#A65CF6" stroke-width="16" vector-effect="non-scaling-stroke" stroke-linecap="round"/>
            <ellipse class="fire-wave fire-wave--aura" cx="50" cy="50" rx="49" ry="49" pathLength="100" stroke="#EC4899" stroke-width="10" vector-effect="non-scaling-stroke" stroke-linecap="round"/>
            <ellipse class="fire-wave" cx="50" cy="50" rx="49" ry="49" pathLength="100" stroke="#F0E1FF" stroke-width="3" vector-effect="non-scaling-stroke" stroke-linecap="round"/>
          </svg>
        </div>

        <div class="hero-orbit hero-orbit--far">
          <svg class="hoop-svg" viewBox="0 0 100 100" preserveAspectRatio="none" fill="none" overflow="visible">
            <ellipse class="fr-halo" cx="50" cy="50" rx="49" ry="49" stroke="#7C3AED" stroke-width="14" vector-effect="non-scaling-stroke"/>
            <ellipse class="fr-mid" cx="50" cy="50" rx="49" ry="49" stroke="#7C3AED" stroke-width="7" vector-effect="non-scaling-stroke"/>
            <ellipse class="fr-tube" cx="50" cy="50" rx="49" ry="49" stroke="#3a2154" stroke-width="4" vector-effect="non-scaling-stroke"/>
            <ellipse class="fr-core" cx="50" cy="50" rx="49" ry="49" stroke="#C49AFF" stroke-width="1.25" vector-effect="non-scaling-stroke"/>
            <ellipse class="fire-swell" cx="50" cy="50" rx="49" ry="49" pathLength="100" stroke="#7C3AED" stroke-width="12" vector-effect="non-scaling-stroke" stroke-linecap="round"/>
            <ellipse class="fire-wave fire-wave--aura" cx="50" cy="50" rx="49" ry="49" pathLength="100" stroke="#A65CF6" stroke-width="8" vector-effect="non-scaling-stroke" stroke-linecap="round"/>
            <ellipse class="fire-wave" cx="50" cy="50" rx="49" ry="49" pathLength="100" stroke="#C49AFF" stroke-width="2.5" vector-effect="non-scaling-stroke" stroke-linecap="round"/>
          </svg>
        </div>
      </div>
    </div>

    <div class="section-inner subhero-content">
      <p class="eyebrow justify-center reveal">Leistung 02 / SEA</p>
      <h1 id="sea-heading" class="subhero-h1 reveal">
        <span class="brush-accent brush-accent--xl">SEA</span>
        <span class="subhero-title">&amp; PPC für KMU, Startups &amp; NGOs</span>
      </h1>
      <p class="subhero-subline reveal">Werbung, die sich rechnet.</p>
      <p class="subhero-intro reveal mx-auto">
        Google Ads, Microsoft Ads &amp; PPC-Kampagnen mit messbarem Return –
        datengetrieben, transparent, ohne Agentur-Overhead.
      </p>
      <div class="hero-actions justify-center reveal">
        <a href="/de/kontakt/" class="btn btn-primary">Kostenloses Erstgespräch</a>
        <a href="/de/preise/" class="btn btn-secondary">Preise ansehen</a>
      </div>
    </div>
  </section>

  <!-- ==================== PLATTFORMEN (2×2 TILT-CARDS + CHECKS) ==================== -->
  <section class="section" aria-labelledby="plattformen-heading">
    <FireHoop uid="sea-plattformen" cool wave={false} style="width:30rem; bottom:-13rem; left:-15rem;" />

    <div class="section-inner">
      <header class="section-header text-center mx-auto">
        <p class="eyebrow justify-center">Plattformen</p>
        <h2 id="plattformen-heading" class="section-title">
          Google Ads, Microsoft Ads &amp; <span class="spectrum-text">Social Ads</span>
        </h2>
        <p class="section-intro mx-auto">
          Jede Plattform hat ihre Stärken. Ich schalte dort, wo Deine Zielgruppe tatsächlich ist – nicht überall.
        </p>
      </header>

      <div class="grid md:grid-cols-2 gap-6">
        <IronTilt className="service-card" client:visible>
          <span class="service-card-num" aria-hidden="true">01</span>
          <div class="service-card-icon" aria-hidden="true">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
          </div>
          <h3 class="service-card-title">Google Ads Kampagnen</h3>
          <p class="service-card-text">Search, Display, Shopping und Performance Max. Von der Keyword-Strategie über Negativlisten bis zum Gebotsmanagement – ich baue Strukturen, die skalieren.</p>
          <ul class="service-checks">
            <li>Search-Kampagnen mit Intent-Fokus</li>
            <li>Shopping &amp; Performance Max</li>
            <li>YouTube &amp; Display Remarketing</li>
          </ul>
        </IronTilt>

        <IronTilt className="service-card" delay={80} client:visible>
          <span class="service-card-num" aria-hidden="true">02</span>
          <div class="service-card-icon" aria-hidden="true">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
          </div>
          <h3 class="service-card-title">Microsoft Ads</h3>
          <p class="service-card-text">Das unterschätzte PPC-Netzwerk. Günstigere CPCs, LinkedIn-Targeting für B2B und eine ältere, kaufkräftigere Zielgruppe. Oft die rentabelste Ergänzung zu Google.</p>
          <ul class="service-checks">
            <li>B2B-Targeting via LinkedIn-Profile</li>
            <li>Niedrigere Wettbewerbsdichte</li>
            <li>Import &amp; Synergien zu Google Ads</li>
          </ul>
        </IronTilt>

        <IronTilt className="service-card" client:visible>
          <span class="service-card-num" aria-hidden="true">03</span>
          <div class="service-card-icon" aria-hidden="true">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
          </div>
          <h3 class="service-card-title">Social Ads</h3>
          <p class="service-card-text">Meta, LinkedIn und weitere Netzwerke. Nicht jede Zielgruppe sucht aktiv – manche muss man finden. Ich baue Funnel, die aus Interesse Handlung machen.</p>
          <ul class="service-checks">
            <li>Meta Ads (Facebook &amp; Instagram)</li>
            <li>LinkedIn Ads für B2B-Lead-Gen</li>
            <li>Lookalike- &amp; Custom Audiences</li>
          </ul>
        </IronTilt>

        <IronTilt className="service-card" delay={80} client:visible>
          <span class="service-card-num" aria-hidden="true">04</span>
          <div class="service-card-icon" aria-hidden="true">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
          </div>
          <h3 class="service-card-title">Display Werbung &amp; Retargeting</h3>
          <p class="service-card-text">Werbung für Menschen, die Deine Website schon kennen. Display-Netzwerke, Remarketing-Listen und dynamische Anzeigen – für die zweite und dritte Berührung.</p>
          <ul class="service-checks">
            <li>Remarketing-Listen &amp; Segmente</li>
            <li>Dynamische Display-Anzeigen</li>
            <li>Google Display Network &amp; Partner</li>
          </ul>
        </IronTilt>
      </div>
    </div>
  </section>

  <!-- ==================== KAMPAGNENZIELE (SPLIT + STICKY) ==================== -->
  <section class="section section--soft" aria-labelledby="ziele-heading">
    <div class="glow-cloud-wrap" style="width:26rem;height:26rem;top:-8rem;right:-10rem;">
      <div class="glow-cloud glow-cloud--pink"></div>
      <i class="cloud-spark" style="--x:50%; --c:#EC4899; --d:-4s; --dur:7s;"></i>
    </div>

    <div class="section-inner split-grid">
      <header class="split-head">
        <p class="eyebrow">Kampagnenziele</p>
        <h2 id="ziele-heading" class="section-title">
          Die richtige Strategie <span class="spectrum-text">für jedes Ziel</span>
        </h2>
        <p class="section-intro">
          Nicht jede Kampagne muss sofort verkaufen. Manchmal brauchst Du Reichweite,
          manchmal Leads, manchmal direkten Umsatz. Ich wähle das Setup danach aus.
        </p>
      </header>

      <ol class="service-rows reveal">
        <li class="service-row">
          <span class="service-row-num mono-label" aria-hidden="true">01</span>
          <div>
            <h3>Awareness &amp; Branding</h3>
            <p>Deine Marke sichtbar machen, bevor die Suche beginnt. Display, Video und Social Ads für Reichweite, Wiedererkennung und Markenbekanntheit.</p>
          </div>
        </li>
        <li class="service-row">
          <span class="service-row-num mono-label" aria-hidden="true">02</span>
          <div>
            <h3>Lead Generation</h3>
            <p>Formulare, Downloads, Demo-Anfragen. Ich baue Funnel, die Interesse in qualifizierte Kontakte verwandeln – mit Tracking, das jede Quelle zuordnet.</p>
          </div>
        </li>
        <li class="service-row">
          <span class="service-row-num mono-label" aria-hidden="true">03</span>
          <div>
            <h3>Umsatz &amp; E-Commerce</h3>
            <p>Direkte Verkäufe, Warenkörbe, Buchungen. Shopping-Kampagnen, dynamisches Remarketing und Conversion-optimierte Landingpages für maximalen ROAS.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- ==================== PPC KPIs (RAIL) ==================== -->
  <section class="section" aria-labelledby="kpis-heading">
    <div class="glow-cloud-wrap" style="width:26rem;height:26rem;top:-6rem;right:-8rem;">
      <div class="glow-cloud glow-cloud--purple"></div>
      <i class="cloud-spark" style="--x:40%; --c:#C49AFF; --d:-1.5s; --dur:7.5s;"></i>
      <i class="cloud-spark" style="--x:62%; --c:#EC4899; --d:-5s; --dur:6.5s;"></i>
    </div>
    <FireHoop uid="sea-kpi" cool tilt style="width:40rem; top:-18rem; left:-22rem;" />

    <div class="section-inner">
      <header class="section-header text-center mx-auto">
        <p class="eyebrow justify-center">Erfolgsmessung</p>
        <h2 id="kpis-heading" class="section-title">
          <span class="brush-accent">SEA</span> Reporting &amp; <span class="spectrum-text">PPC KPIs</span>
        </h2>
        <p class="section-intro mx-auto">
          Ich optimiere nicht nach Klicks. Ich optimiere nach den Zahlen, die Dein Geschäft voranbringen.
        </p>
      </header>

      <div class="kpi-rail reveal">
        <div class="kpi-cell">
          <div class="kpi-value">ROAS</div>
          <div class="kpi-label">Return on Ad Spend</div>
        </div>
        <div class="kpi-cell">
          <div class="kpi-value">CPA</div>
          <div class="kpi-label">Cost per Acquisition</div>
        </div>
        <div class="kpi-cell">
          <div class="kpi-value">CTR</div>
          <div class="kpi-label">Click-Through-Rate</div>
        </div>
        <div class="kpi-cell">
          <div class="kpi-value">CVR</div>
          <div class="kpi-label">Conversion Rate</div>
        </div>
        <div class="kpi-cell">
          <div class="kpi-value">Reichweite</div>
          <div class="kpi-label">Erreichte Nutzer</div>
        </div>
        <div class="kpi-cell">
          <div class="kpi-value">IS</div>
          <div class="kpi-label">Impression Share</div>
        </div>
      </div>

      <p class="kpi-note reveal">
        Transparentes Reporting, das zeigt, welcher Euro was gebracht hat – verständlich statt Blackbox.
      </p>
    </div>
  </section>

  <!-- ==================== OPTIMIERUNG (ORBIT-BOGEN) ==================== -->
  <section class="section section--soft" aria-labelledby="prozess-heading">
    <div class="glow-cloud-wrap" style="width:24rem;height:24rem;top:-6rem;left:-8rem;">
      <div class="glow-cloud glow-cloud--pink glow-cloud--float"></div>
      <i class="cloud-spark" style="--x:48%; --c:#A65CF6; --d:-3.5s; --dur:7s;"></i>
    </div>
    <FireHoop uid="sea-prozess" wave={false} style="width:28rem; bottom:-12rem; right:-13rem;" />

    <div class="section-inner">
      <header class="section-header text-center mx-auto">
        <p class="eyebrow justify-center">So arbeite ich</p>
        <h2 id="prozess-heading" class="section-title">
          <span class="brush-accent">SEA</span> Optimierung: <span class="spectrum-text">Datengetrieben</span> statt Bauchgefühl
        </h2>
        <p class="section-intro mx-auto">
          Kein Set-and-forget. Kampagnen leben von kontinuierlicher Analyse, Testen und Anpassungen.
        </p>
      </header>
    </div>

    <div class="orbit-wrapper reveal">
      <svg class="orbit-path" viewBox="0 0 100 100" preserveAspectRatio="none" fill="none" aria-hidden="true">
        <defs>
          <linearGradient id="orbitStrokeSea" x1="0" y1="0" x2="100" y2="0" gradientUnits="userSpaceOnUse">
            <stop offset="0"   stop-color="#C49AFF" stop-opacity="0.9"/>
            <stop offset="0.5" stop-color="#EC4899" stop-opacity="0.7"/>
            <stop offset="1"   stop-color="#A65CF6" stop-opacity="0.8"/>
          </linearGradient>
        </defs>
        <path class="orbit-halo" d="M 0 20 C 40 20, 60 80, 100 80"
              stroke="#8B5CF6" stroke-width="10" vector-effect="non-scaling-stroke"/>
        <path class="orbit-base" d="M 0 20 C 40 20, 60 80, 100 80"
              stroke="url(#orbitStrokeSea)" stroke-width="2.5" vector-effect="non-scaling-stroke"/>
      </svg>

      <ol class="orbit-steps">
        <li class="orbit-step">
          <span class="orbit-node" style="--c:#C49AFF" aria-hidden="true"></span>
          <p class="mono-label">01</p>
          <h3>Audit &amp; Analyse</h3>
          <p>Bestandsaufnahme Deiner aktuellen Kampagnen, Wettbewerbsanalyse und Identifikation der größten Hebel. Wo wird Budget verbrannt? Wo fehlt Potenzial?</p>
        </li>
        <li class="orbit-step">
          <span class="orbit-node" style="--c:#EC4899" aria-hidden="true"></span>
          <p class="mono-label">02</p>
          <h3>Setup &amp; Struktur</h3>
          <p>Kampagnen-Architektur, Keyword-Strategie, Anzeigentexte und Conversion-Tracking. Solide Fundamente, auf denen man skalieren kann.</p>
        </li>
        <li class="orbit-step">
          <span class="orbit-node" style="--c:#A65CF6" aria-hidden="true"></span>
          <p class="mono-label">03</p>
          <h3>Laufende Optimierung &amp; Reporting</h3>
          <p>A/B-Tests, Gebotsanpassungen, Negativlisten-Pflege und Budget-Shift. Transparentes Reporting, das zeigt, welcher Euro was gebracht hat.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ==================== CTA ==================== -->
  <section class="section section--cta" aria-labelledby="sea-cta-heading">
    <div class="glow-cloud-wrap" style="width:30rem;height:30rem;bottom:-10rem;right:-10rem;">
      <div class="glow-cloud glow-cloud--pink"></div>
      <i class="cloud-spark" style="--x:45%; --c:#C49AFF; --d:-3s; --dur:7.5s;"></i>
    </div>
    <FireHoop uid="sea-cta" cool style="width:26rem; top:-11rem; left:-13rem;" />

    <div class="section-inner max-w-3xl mx-auto text-center relative z-10">
      <h2 id="sea-cta-heading" class="section-title text-3xl md:text-5xl mb-6">
        Lass uns prüfen, wo Dein <span class="spectrum-text">Budget</span> am härtesten arbeitet.
      </h2>
      <p class="text-lg text-text-secondary mb-10 leading-relaxed max-w-2xl mx-auto">
        Ob Neustart oder Optimierung bestehender Kampagnen: Lass uns in einem kostenlosen
        Erstgespräch herausfinden, wo Dein größtes Potenzial liegt.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-5">
        <a href="/de/kontakt/" class="btn btn-primary">Kostenloses Erstgespräch</a>
        <a href="/de/preise/" class="btn btn-secondary">Preise &amp; Pakete</a>
      </div>
    </div>
  </section>

</Layout>
---
import Layout from '../../layouts/Layout.astro';
import HeroAssembler from '../../components/HeroAssembler.tsx';
import { getCollection } from 'astro:content';

const lang = 'de';
const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(p => p.slug.startsWith('de/'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const meta = {
  title: "Valorferrum – Freelancer für digitale Sichtbarkeit | SEO, SEA & Webentwicklung",
  description: "Dein Erfolg. Mein Maßstab. Als Freelancer verbinde ich SEO, SEA, Webentwicklung und Tracking – aus einer Hand, ohne Agentur-Overhead. Für KMU, Startups und NGOs.",
};
---

<Layout title={meta.title} description={meta.description} lang={lang}>
  
  <!-- ==================== HERO MIT ANIMATION ==================== -->
  <section class="relative" aria-label="Hero">
    <HeroAssembler client:visible lang="de" />
  </section>

  <!-- Divider -->
  <hr class="vf-divider max-w-6xl mx-auto" />

  <!-- ==================== LEISTUNGEN ==================== -->
  <section class="py-24 px-6 bg-bg" aria-labelledby="leistungen-heading">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <p class="reveal font-mono text-xs uppercase tracking-[0.24em] text-primary mb-4">SERVICE_SYSTEM</p>
        <h2 id="leistungen-heading" class="reveal text-3xl md:text-4xl font-display font-bold text-text-primary mb-4">
          Vier Disziplinen. Eine Strategie.
        </h2>
        <p class="reveal text-text-secondary max-w-2xl mx-auto" style="transition-delay: 100ms;">
          SEO, SEA, Webentwicklung und Tracking greifen ineinander. Ich optimiere Deine Sichtbarkeit technisch,
          inhaltlich und bezahlt – und baue die Infrastruktur, die das alles trägt.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <!-- SEO -->
        <a href="/de/leistungen/seo" class="vf-glow vf-card-glow reveal card group relative p-8 rounded-2xl bg-surface border border-border hover:border-primary/30 transition-all duration-500">
          <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-spectrum-purple/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative">
            <div class="w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center mb-6 group-hover:bg-primary/20 transition-colors">
              <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </div>
            <h3 class="text-xl font-display font-semibold text-text-primary mb-3 group-hover:text-primary transition-colors">SEO & Suchmaschinenoptimierung</h3>
            <p class="text-text-secondary leading-relaxed mb-4">
              Onpage-Optimierung, technisches SEO und Linkaufbau: Ich bringe Deine Website nach vorne
              bei Google – nachhaltig und datenbasiert.
            </p>
            <span class="text-primary text-sm font-medium flex items-center gap-2">
              Mehr zur SEO <span class="group-hover:translate-x-1 transition-transform">→</span>
            </span>
          </div>
        </a>

        <!-- SEA -->
        <a href="/de/leistungen/sea" class="vf-glow vf-card-glow reveal card group relative p-8 rounded-2xl bg-surface border border-border hover:border-primary/30 transition-all duration-500" style="transition-delay: 100ms;">
          <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-spectrum-pink/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative">
            <div class="w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center mb-6 group-hover:bg-primary/20 transition-colors">
              <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"></path></svg>
            </div>
            <h3 class="text-xl font-display font-semibold text-text-primary mb-3 group-hover:text-primary transition-colors">SEA & Google Ads</h3>
            <p class="text-text-secondary leading-relaxed mb-4">
              Bezahlte Suchmaschinenwerbung, die sich rechnet: Kampagnen-Setup, Keyword-Strategie
              und laufende Optimierung für maximale Effizienz.
            </p>
            <span class="text-primary text-sm font-medium flex items-center gap-2">
              Mehr zur SEA <span class="group-hover:translate-x-1 transition-transform">→</span>
            </span>
          </div>
        </a>

        <!-- Webentwicklung -->
        <a href="/de/leistungen/webentwicklung" class="vf-glow vf-card-glow reveal card group relative p-8 rounded-2xl bg-surface border border-border hover:border-primary/30 transition-all duration-500" style="transition-delay: 200ms;">
          <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-spectrum-blue/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative">
            <div class="w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center mb-6 group-hover:bg-primary/20 transition-colors">
              <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
            </div>
            <h3 class="text-xl font-display font-semibold text-text-primary mb-3 group-hover:text-primary transition-colors">Webentwicklung</h3>
            <p class="text-text-secondary leading-relaxed mb-4">
              Schnelle, barrierefreie Websites mit Astro, React oder WordPress –
              technisch sauber und suchmaschinenoptimiert gebaut.
            </p>
            <span class="text-primary text-sm font-medium flex items-center gap-2">
              Mehr zur Webentwicklung <span class="group-hover:translate-x-1 transition-transform">→</span>
            </span>
          </div>
        </a>

        <!-- Tracking -->
        <a href="/de/leistungen/tracking" class="vf-glow vf-card-glow reveal card group relative p-8 rounded-2xl bg-surface border border-border hover:border-primary/30 transition-all duration-500" style="transition-delay: 300ms;">
          <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-primary/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative">
            <div class="w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center mb-6 group-hover:bg-primary/20 transition-colors">
              <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
            </div>
            <h3 class="text-xl font-display font-semibold text-text-primary mb-3 group-hover:text-primary transition-colors">Tracking & Analytics</h3>
            <p class="text-text-secondary leading-relaxed mb-4">
              Google Tag Manager, Conversion-Tracking und datenschutzkonforme Webanalyse:
              Ich baue die Infrastruktur für datengetriebene Entscheidungen.
            </p>
            <span class="text-primary text-sm font-medium flex items-center gap-2">
              Mehr zum Tracking <span class="group-hover:translate-x-1 transition-transform">→</span>
            </span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <hr class="vf-divider max-w-6xl mx-auto" />

  <!-- ==================== WARUM VALORFERRUM (3 VERKAUFSARGUMENTE) ==================== -->
  <section class="py-24 px-6 bg-surface relative overflow-hidden" aria-labelledby="usp-heading">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-gradient-to-b from-primary/5 to-transparent rounded-full blur-3xl"></div>

    <div class="max-w-6xl mx-auto relative">
      <div class="text-center mb-16">
        <p class="reveal font-mono text-xs uppercase tracking-[0.24em] text-primary mb-4">WHY_VALORFERRUM</p>
        <h2 id="usp-heading" class="reveal text-3xl md:text-4xl font-display font-bold text-text-primary mb-4">
          Eine Person. Keine Brüche. Faire Kalkulation.
        </h2>
        <p class="reveal text-text-secondary max-w-2xl mx-auto" style="transition-delay: 100ms;">
          Keine Silos, keine Kommunikationsketten, keine versteckten Kosten.
          Ich bin Entwickler, Marketer und Analyst in einer Person.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <!-- USP 1: Transparente Preisgestaltung -->
        <div class="vf-glow vf-card-glow reveal text-center p-6 rounded-2xl bg-bg/50 border border-border/50">
          <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <a href="/de/preise" class="inline-block text-5xl font-display font-bold text-primary mb-2 hover:text-primary-light transition-colors">
            110 €<span class="text-lg text-text-secondary font-normal">/h</span>
          </a>
          <h3 class="text-lg font-semibold text-text-primary mb-3">Transparente Preisgestaltung</h3>
          <p class="text-text-secondary text-sm leading-relaxed">
            Fair kalkuliert, nicht ausgedacht. Die Preise basieren Kostendeckung mit geringem Risiko-Puffer.
          </p>
        </div>

        <!-- USP 2: Kein Agentur-Overhead -->
        <div class="vf-glow vf-card-glow reveal text-center p-6 rounded-2xl bg-bg/50 border border-border/50" style="transition-delay: 100ms;">
          <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
          </div>
          <div class="text-5xl font-display font-bold text-primary mb-2">1<span class="text-lg text-text-secondary font-normal"> Person</span></div>
          <h3 class="text-lg font-semibold text-text-primary mb-3">Kein Agentur-Overhead</h3>
          <p class="text-text-secondary text-sm leading-relaxed">
            Kein Büro, kein Projektmanager, keine Geschäftsführung. Du zahlst für eine Sache: meine Zeit und mein Know-how.
          </p>
        </div>

        <!-- USP 3: Erwartungsmanagement -->
        <div class="vf-glow vf-card-glow reveal text-center p-6 rounded-2xl bg-bg/50 border border-border/50" style="transition-delay: 200ms;">
          <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <div class="text-5xl font-display font-bold text-primary mb-2">100<span class="text-lg text-text-secondary font-normal">% ehrlich</span></div>
          <h3 class="text-lg font-semibold text-text-primary mb-3">Realistische Ziele</h3>
          <p class="text-text-secondary text-sm leading-relaxed">
            Kein "Platz 1 in 3 Monaten". Ich zeige euch realistische Erfolge und formuliere mit euch zusammen die Ziele.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <hr class="vf-divider max-w-6xl mx-auto" />

  <!-- ==================== PROZESS ==================== -->
  <section class="py-24 px-6 bg-bg" aria-labelledby="prozess-heading">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-16">
        <p class="reveal font-mono text-xs uppercase tracking-[0.24em] text-primary mb-4">PROCESS_PIPELINE</p>
        <h2 id="prozess-heading" class="reveal text-3xl md:text-4xl font-display font-bold text-text-primary mb-4">
          Analyse → Strategie → Umsetzung → Messung
        </h2>
        <p class="reveal text-text-secondary max-w-2xl mx-auto" style="transition-delay: 100ms;">
          Kein Blindflug. Jeder Schritt ist nachvollziehbar – von der ersten Analyse bis zum laufenden Reporting.
        </p>
      </div>

      <div class="space-y-6">
        <div class="vf-glow vf-card-glow reveal flex gap-6 p-6 rounded-xl bg-surface border border-border hover:border-primary/20 transition-colors">
          <div class="text-3xl font-display font-bold text-primary/40 shrink-0 w-12">01</div>
          <div>
            <h3 class="text-lg font-semibold text-text-primary mb-2">Analyse & Status Quo</h3>
            <p class="text-text-secondary leading-relaxed">
              Ich analysiere Deine Website, Dein aktuelles Google Ranking und Deine Wettbewerber.
              Wo stehst Du – und wo sind die größten Hebel?
            </p>
          </div>
        </div>
        <div class="vf-glow vf-card-glow reveal flex gap-6 p-6 rounded-xl bg-surface border border-border hover:border-primary/20 transition-colors" style="transition-delay: 100ms;">
          <div class="text-3xl font-display font-bold text-primary/40 shrink-0 w-12">02</div>
          <div>
            <h3 class="text-lg font-semibold text-text-primary mb-2">Strategie & Konzept</h3>
            <p class="text-text-secondary leading-relaxed">
              Gemeinsam definieren wir Ziele, Budget und Timeline. Ob SEO-Relaunch, neue Google-Ads-Kampagne
              oder Website-Projekt – das Fundament entscheidet.
            </p>
          </div>
        </div>
        <div class="vf-glow vf-card-glow reveal flex gap-6 p-6 rounded-xl bg-surface border border-border hover:border-primary/20 transition-colors" style="transition-delay: 200ms;">
          <div class="text-3xl font-display font-bold text-primary/40 shrink-0 w-12">03</div>
          <div>
            <h3 class="text-lg font-semibold text-text-primary mb-2">Umsetzung & Optimierung</h3>
            <p class="text-text-secondary leading-relaxed">
              Ich setze um, messe Ergebnisse und iteriere. Datengesteuert, nicht nach Bauchgefühl.
              Regelmäßige Updates inklusive.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <hr class="vf-divider max-w-6xl mx-auto" />

  <!-- ==================== ÜBER MICH TEASER ==================== -->
  <section class="py-24 px-6 bg-surface" aria-labelledby="about-heading">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center gap-12">
      <div class="reveal w-48 h-48 rounded-2xl bg-gradient-to-br from-primary via-spectrum-pink to-spectrum-blue shrink-0 flex items-center justify-center shadow-lg shadow-primary/20">
        <span class="text-6xl">👤</span>
      </div>
      <div>
        <p class="reveal font-mono text-xs uppercase tracking-[0.24em] text-primary mb-4">ABOUT_SIGNAL</p>
        <h2 id="about-heading" class="reveal text-3xl md:text-4xl font-display font-bold text-text-primary mb-4">
          Der Mensch hinter Valorferrum
        </h2>
        <p class="reveal text-text-secondary leading-relaxed mb-6" style="transition-delay: 100ms;">
          Ich bin der Kopf hinter Valorferrum – kein Team, keine Ausreden.
          Als Freelancer verbinde ich Agentur-Erfahrung mit der Effizienz einer Ein-Mann-Operation.
          Technisch tief, marketingstark, immer datenbasiert. Mein Maßstab ist Dein Erfolg,
          nicht mein Stundennachweis.
        </p>
        <a href="/de/ueber-mich" class="vf-glow vf-btn-frame reveal inline-flex items-center gap-2 px-6 py-3 rounded-lg border border-primary/30 hover:border-primary text-primary hover:text-primary-light font-medium transition-all group" style="transition-delay: 200ms;">
          Mehr über mich <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <hr class="vf-divider max-w-6xl mx-auto" />

  <!-- ==================== BLOG TEASER ==================== -->
  {posts.length > 0 && (
    <section class="py-24 px-6 bg-bg" aria-labelledby="blog-heading">
      <div class="max-w-6xl mx-auto">
        <div class="flex justify-between items-end mb-12">
          <div>
            <p class="reveal font-mono text-xs uppercase tracking-[0.24em] text-primary mb-2">KNOWLEDGE_BASE</p>
            <h2 id="blog-heading" class="reveal text-3xl md:text-4xl font-display font-bold text-text-primary mb-2">Wissen & Insights</h2>
            <p class="reveal text-text-secondary" style="transition-delay: 100ms;">Praxisnahe Einblicke in SEO, SEA und Webentwicklung.</p>
          </div>
          <a href="/de/blog" class="hidden md:block text-primary hover:text-primary-light font-medium transition-colors">Alle Artikel →</a>
        </div>
        <div class="grid md:grid-cols-2 gap-6">
          {posts.map((post, i) => (
            <a href={`/de/blog/${post.slug.replace('de/', '')}`} class="vf-glow vf-card-glow reveal card group p-6 rounded-xl bg-surface border border-border hover:border-primary/30 transition-all duration-300" style={`transition-delay: ${(i + 1) * 100}ms;`}>
              <div class="text-sm text-primary mb-3">{new Date(post.data.pubDate).toLocaleDateString('de-DE')}</div>
              <h3 class="text-xl font-semibold text-text-primary mb-3 group-hover:text-primary transition-colors">{post.data.title}</h3>
              <p class="text-text-secondary text-sm line-clamp-2">{post.data.description}</p>
            </a>
          ))}
        </div>
        <a href="/de/blog" class="md:hidden mt-6 block text-primary hover:text-primary-light font-medium transition-colors">Alle Artikel →</a>
      </div>
    </section>
  )}

  <!-- Divider -->
  <hr class="vf-divider max-w-6xl mx-auto" />

  <!-- ==================== CTA ==================== -->
  <section class="py-24 px-6 relative overflow-hidden" aria-labelledby="cta-heading">
    <div class="absolute inset-0 bg-gradient-to-br from-spectrum-purple/20 via-spectrum-pink/10 to-spectrum-blue/20"></div>
    <div class="max-w-3xl mx-auto text-center relative">
      <p class="reveal font-mono text-xs uppercase tracking-[0.24em] text-primary mb-4">INITIAL_CHECK</p>
      <h2 id="cta-heading" class="reveal text-3xl md:text-5xl font-display font-bold text-text-primary mb-6">
        Lass uns prüfen, wo dein größter Hebel liegt.
      </h2>
      <p class="reveal text-lg text-text-secondary mb-8 leading-relaxed" style="transition-delay: 100ms;">
        Keine Verkaufsmasche. Ein ehrlicher Blick auf Potenzial, Aufwand und Prioritäten –
        ob SEO-Optimierung, Google Ads oder eine neue Website.
      </p>
      <div class="reveal flex flex-col sm:flex-row gap-4 justify-center" style="transition-delay: 200ms;">
        <a href="/de/kontakt" class="vf-glow vf-btn-frame px-8 py-4 bg-primary hover:bg-primary-light text-white font-semibold rounded-lg transition-all duration-300 shadow-lg shadow-primary/25 hover:shadow-primary/40 hover:-translate-y-0.5 active:translate-y-0">
          Kostenloses Erstgespräch
        </a>
        <a href="/de/preise" class="vf-glow vf-btn-frame px-8 py-4 border border-white/20 hover:border-primary text-text-primary hover:text-primary rounded-lg transition-all duration-300 hover:bg-primary/5">
          Preise & Pakete
        </a>
      </div>
    </div>
  </section>
</Layout>
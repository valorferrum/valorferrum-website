---
import Layout from '../../layouts/Layout.astro';
import FlameButton from '../../components/FlameButton';
import SpectrumRibbons from '../../components/SpectrumRibbons';
import Glints from '../../components/Glints.astro';
import { getCollection } from 'astro:content';
import ProcessRibbon from '../../components/ProcessRibbon.astro';

// Neueste DE-Artikel für den Blog-Teaser (§8 Content-Architektur)
const posts = (await getCollection('blog', (post) => post.data.lang === 'de'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
---

<Layout title="Valorferrum – Freelancer & Berater für SEO, SEA & Webentwicklung">

  <!-- ==================== HERO: SPECTRUM FLUX ==================== -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-bg">
    <!-- L0: Nebel-Haze -->
    <div class="vf-nebula absolute -inset-[12%]" aria-hidden="true"></div>
    <!-- L1: Star-Sparkles + Prismen -->
    <Glints density={26} seed={11} />
    <!-- L2: liquid Ribbons, wellenartig animiert -->
    <SpectrumRibbons client:visible variant="hero" />
    <!-- Lesbarkeit: Content-Zone ruhig -->
    <div class="absolute inset-0 bg-gradient-to-b from-bg/60 via-transparent to-bg/70" aria-hidden="true"></div>

    <!-- Content -->
    <div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
      <!-- SEO-H1 mit Pflicht-Keywords (§7.2) -->
      <h1 class="text-5xl md:text-7xl font-display font-bold text-text-primary mb-6 tracking-tight">
        Dein <span class="bg-gradient-to-r from-primary to-spectrum-pink bg-clip-text text-transparent">Freelancer</span> & Berater<br />
        für digitale Sichtbarkeit
      </h1>

      <!-- Subline / Claim (§1) -->
      <p class="text-xl md:text-2xl text-text-secondary mb-10 font-body leading-relaxed">
        Digitale Sichtbarkeit, die bleibt. Performance, die besteht.<br />
        <span class="text-text-muted italic">Dein Erfolg. Mein Maßstab.</span>
      </p>

      <!-- CTAs: Gradient-Pill (primär) + Neon-Ring-Pill (sekundär) -->
      <div class="flex flex-col sm:flex-row gap-6 justify-center items-center">
        <FlameButton client:visible href="/de/kontakt/" variant="gradient">Erstgespräch vereinbaren</FlameButton>
        <FlameButton client:visible href="/de/leistungen/" variant="neon">Leistungen entdecken</FlameButton>
      </div>
          <!-- ... Content div ... -->
    
      <!-- Weicher Übergang in die nächste Sektion -->
      <div class="vf-hero-fade-out">
      </div>
    </div>
  </section>

  <!-- ==================== LEISTUNGEN ==================== -->
  <section class="vf-fade-section py-24 px-6" aria-labelledby="leistungen-heading">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <p class="reveal vf-kicker font-mono text-xs uppercase tracking-[0.24em] text-primary mb-4">SERVICE_SYSTEM</p>
        <h2 id="leistungen-heading" class="reveal text-3xl md:text-4xl font-display font-bold text-text-primary mb-4">
          Vier Disziplinen. <span class="bg-gradient-to-r from-primary to-spectrum-pink bg-clip-text text-transparent">Eine Strategie.</span>
        </h2>
        <p class="reveal text-text-secondary max-w-2xl mx-auto" style="transition-delay: 100ms;">
          SEO, SEA, Webentwicklung und Tracking greifen ineinander. Ich optimiere Deine Sichtbarkeit technisch,
          inhaltlich und bezahlt – und baue die Infrastruktur, die das alles trägt.
        </p>
      </div>

      <div class="vf-bento-services">
        <!-- SEO (Spectrum: Purple) -->
        <a href="/de/leistungen/seo/" class="vf-card vf-layer-card card reveal group relative p-8 md:p-10 rounded-3xl bg-surface/90 border border-border hover:border-spectrum-purple/40 transition-all duration-500 md:col-span-7 md:min-h-[360px] vf-lift-1">
          <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-spectrum-purple/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative">
            <div class="w-12 h-12 rounded-lg bg-spectrum-purple/10 flex items-center justify-center mb-6 group-hover:bg-spectrum-purple/20 transition-colors">
              <svg class="w-6 h-6 text-spectrum-purple" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </div>
            <h3 class="text-xl font-display font-semibold text-text-primary mb-3 group-hover:text-spectrum-purple transition-colors">SEO & Suchmaschinenoptimierung</h3>
            <p class="text-text-secondary leading-relaxed mb-4">
              Onpage-Optimierung, technisches SEO und Linkaufbau: Ich bringe Deine Website nach vorne
              bei Google – nachhaltig und datenbasiert.
            </p>
            <span class="text-spectrum-purple text-sm font-medium flex items-center gap-2">
              Mehr zur SEO <span class="group-hover:translate-x-1 transition-transform">→</span>
            </span>
          </div>
        </a>

        <!-- SEA (Spectrum: Pink) -->
        <a href="/de/leistungen/sea/" class="vf-card vf-layer-card card reveal group relative p-8 rounded-3xl bg-surface/80 border border-border hover:border-spectrum-pink/40 transition-all duration-500 md:col-span-5 md:min-h-[300px] vf-lift-2" style="transition-delay: 100ms;">
          <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-spectrum-pink/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative">
            <div class="w-12 h-12 rounded-lg bg-spectrum-pink/10 flex items-center justify-center mb-6 group-hover:bg-spectrum-pink/20 transition-colors">
              <svg class="w-6 h-6 text-spectrum-pink" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"></path></svg>
            </div>
            <h3 class="text-xl font-display font-semibold text-text-primary mb-3 group-hover:text-spectrum-pink transition-colors">SEA & Google Ads</h3>
            <p class="text-text-secondary leading-relaxed mb-4">
              Bezahlte Suchmaschinenwerbung, die sich rechnet: Kampagnen-Setup, Keyword-Strategie
              und laufende Optimierung für maximale Effizienz.
            </p>
            <span class="text-spectrum-pink text-sm font-medium flex items-center gap-2">
              Mehr zur SEA <span class="group-hover:translate-x-1 transition-transform">→</span>
            </span>
          </div>
        </a>

        <!-- Webentwicklung (Spectrum: Blue) -->
        <a href="/de/leistungen/webentwicklung/" class="vf-card vf-layer-card card reveal group relative p-8 md:p-10 rounded-3xl bg-surface/85 border border-border hover:border-spectrum-blue/40 transition-all duration-500 md:col-span-8 md:min-h-[280px] vf-lift-3" style="transition-delay: 200ms;">
          <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-spectrum-blue/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative">
            <div class="w-12 h-12 rounded-lg bg-spectrum-blue/10 flex items-center justify-center mb-6 group-hover:bg-spectrum-blue/20 transition-colors">
              <svg class="w-6 h-6 text-spectrum-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
            </div>
            <h3 class="text-xl font-display font-semibold text-text-primary mb-3 group-hover:text-spectrum-blue transition-colors">Webentwicklung</h3>
            <p class="text-text-secondary leading-relaxed mb-4">
              Schnelle, barrierefreie Websites mit Astro, React oder WordPress –
              technisch sauber und suchmaschinenoptimiert gebaut.
            </p>
            <span class="text-spectrum-blue text-sm font-medium flex items-center gap-2">
              Mehr zur Webentwicklung <span class="group-hover:translate-x-1 transition-transform">→</span>
            </span>
          </div>
        </a>

        <!-- Tracking (Spectrum: Yellow) -->
        <a href="/de/leistungen/tracking/" class="vf-card vf-layer-card card reveal group relative p-8 rounded-3xl bg-surface/80 border border-border hover:border-spectrum-yellow/40 transition-all duration-500 md:col-span-4 md:min-h-[320px] vf-lift-4" style="transition-delay: 300ms;">
          <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-spectrum-yellow/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative">
            <div class="w-12 h-12 rounded-lg bg-spectrum-yellow/10 flex items-center justify-center mb-6 group-hover:bg-spectrum-yellow/20 transition-colors">
              <svg class="w-6 h-6 text-spectrum-yellow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2-2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
            </div>
            <h3 class="text-xl font-display font-semibold text-text-primary mb-3 group-hover:text-spectrum-yellow transition-colors">Tracking & Analytics</h3>
            <p class="text-text-secondary leading-relaxed mb-4">
              Google Tag Manager, Conversion-Tracking und datenschutzkonforme Webanalyse:
              Ich baue die Infrastruktur für datengetriebene Entscheidungen.
            </p>
            <span class="text-spectrum-yellow text-sm font-medium flex items-center gap-2">
              Mehr zum Tracking <span class="group-hover:translate-x-1 transition-transform">→</span>
            </span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <SpectrumRibbons client:visible variant="divider" />

    <!-- ==================== WARUM VALORFERRUM (Soft Glow, Rahmenlos) ==================== -->
  <section class="vf-glow-section py-24 px-6 relative overflow-hidden" aria-labelledby="usp-heading">
    <!-- Optional: Dezente Glints im Hintergrund -->
    <div class="absolute inset-0 opacity-30 pointer-events-none"><Glints density={8} seed={9} /></div>

    <div class="max-w-6xl mx-auto relative z-10">
      <div class="text-center mb-16">
        <p class="reveal vf-kicker font-mono text-xs uppercase tracking-[0.24em] text-primary mb-4">WHY_VALORFERRUM</p>
        <h2 id="usp-heading" class="reveal text-3xl md:text-4xl font-display font-bold text-text-primary mb-4">
          Eine Person. Keine Brüche. <span class="bg-gradient-to-r from-primary to-spectrum-pink bg-clip-text text-transparent">Faire Kalkulation.</span>
        </h2>
        <p class="reveal text-text-secondary max-w-2xl mx-auto" style="transition-delay: 100ms;">
          Keine Silos, keine Kommunikationsketten, keine versteckten Kosten.
          Ich bin Entwickler, Marketer und Analyst in einer Person.
        </p>
      </div>

      <!-- Grid: Mitte breiter (1.2fr), Divider via CSS -->
      <div class="grid grid-cols-1 md:grid-cols-[1fr_1.2fr_1fr] items-center">
        
        <!-- USP 1 -->
        <div class="reveal p-8 md:p-12 text-center flex flex-col items-center relative">
           <!-- Divider Right (Desktop) -->
           <div class="hidden md:block absolute right-0 top-[20%] bottom-[20%] w-px bg-gradient-to-b from-transparent via-border to-transparent"></div>
           
           <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-6">
             <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 1v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
           </div>
           <div class="text-4xl font-display font-bold mb-2 bg-gradient-to-r from-primary to-spectrum-pink bg-clip-text text-transparent">110 €</div>
           <div class="text-sm text-text-muted uppercase tracking-wide mb-4">/ Stunde</div>
           <h3 class="text-lg font-semibold text-text-primary mb-3">Transparente Preisgestaltung</h3>
           <p class="text-text-secondary text-sm leading-relaxed">Fair kalkuliert, nicht ausgedacht. Kostendeckung + Risiko-Puffer.</p>
        </div>

        <!-- USP 2 (MITTE - Größer, Spotlight) -->
        <div class="reveal p-8 md:py-16 md:px-8 text-center flex flex-col items-center relative bg-gradient-to-b from-transparent via-primary/[0.03] to-transparent" style="transition-delay: 100ms;">
           <!-- Dividers Left & Right -->
           <div class="hidden md:block absolute left-0 top-[15%] bottom-[15%] w-px bg-gradient-to-b from-transparent via-primary/30 to-transparent"></div>
           <div class="hidden md:block absolute right-0 top-[15%] bottom-[15%] w-px bg-gradient-to-b from-transparent via-primary/30 to-transparent"></div>

           <div class="w-16 h-16 rounded-2xl bg-primary/20 flex items-center justify-center mb-6 shadow-[0_0_30px_rgba(166,92,246,0.2)]">
             <svg class="w-8 h-8 text-primary-light" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
           </div>
           <div class="text-6xl font-display font-bold mb-2 bg-gradient-to-r from-primary via-spectrum-pink to-spectrum-blue bg-clip-text text-transparent drop-shadow-[0_0_15px_rgba(166,92,246,0.3)]">1</div>
           <div class="text-base text-text-primary font-medium uppercase tracking-wide mb-4">Ansprechpartner</div>
           <h3 class="text-2xl font-semibold text-text-primary mb-3">Kein Agentur-Overhead</h3>
           <p class="text-text-secondary leading-relaxed max-w-xs">Kein Büro, kein PM, keine GF. Du zahlst für meine Zeit und mein Know-how.</p>
        </div>

        <!-- USP 3 -->
        <div class="reveal p-8 md:p-12 text-center flex flex-col items-center relative" style="transition-delay: 200ms;">
           <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-6">
             <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
           </div>
           <div class="text-4xl font-display font-bold mb-2 bg-gradient-to-r from-primary to-spectrum-pink bg-clip-text text-transparent">100%</div>
           <div class="text-sm text-text-muted uppercase tracking-wide mb-4">Ehrlichkeit</div>
           <h3 class="text-lg font-semibold text-text-primary mb-3">Realistische Ziele</h3>
           <p class="text-text-secondary text-sm leading-relaxed">Kein "Platz 1 in 3 Monaten". Wir definieren gemeinsam machbare Erfolge.</p>
        </div>

      </div>
    </div>
  </section>

  <SpectrumRibbons client:visible variant="divider" />

  <!-- ==================== PROZESS (Ribbon-Connector zwischen den Steps) ==================== -->
  <section class="vf-fade-section py-24 px-6" aria-labelledby="prozess-heading">
          <div class="relative mt-4 space-y-8 md:space-y-12">
        <ProcessRibbon />

        <div class="vf-card vf-layer-card card reveal relative z-10 flex gap-6 p-6 rounded-3xl bg-surface border border-border hover:border-primary/20 transition-colors md:w-[72%]">
          <div class="text-3xl font-display font-bold shrink-0 w-12 bg-gradient-to-br from-primary to-spectrum-pink bg-clip-text text-transparent opacity-80">01</div>
          <div>
            <h3 class="text-lg font-semibold text-text-primary mb-2">Analyse & Status Quo</h3>
            <p class="text-text-secondary leading-relaxed">
              Ich analysiere Deine Website, Dein aktuelles Google Ranking und Deine Wettbewerber.
              Wo stehst Du – und wo sind die größten Hebel?
            </p>
          </div>
        </div>

        <div class="vf-card vf-layer-card card reveal relative z-10 flex gap-6 p-6 rounded-3xl bg-surface border border-border hover:border-primary/20 transition-colors md:w-[72%] md:ml-auto" style="transition-delay: 100ms;">
          <div class="text-3xl font-display font-bold shrink-0 w-12 bg-gradient-to-br from-primary to-spectrum-pink bg-clip-text text-transparent opacity-80">02</div>
          <div>
            <h3 class="text-lg font-semibold text-text-primary mb-2">Strategie & Konzept</h3>
            <p class="text-text-secondary leading-relaxed">
              Gemeinsam definieren wir Ziele, Budget und Timeline. Ob SEO-Relaunch, neue Google-Ads-Kampagne
              oder Website-Projekt – das Fundament entscheidet.
            </p>
          </div>
        </div>

        <div class="vf-card vf-layer-card card reveal relative z-10 flex gap-6 p-6 rounded-3xl bg-surface border border-border hover:border-primary/20 transition-colors md:w-[72%]" style="transition-delay: 200ms;">
          <div class="text-3xl font-display font-bold shrink-0 w-12 bg-gradient-to-br from-primary to-spectrum-pink bg-clip-text text-transparent opacity-80">03</div>
          <div>
            <h3 class="text-lg font-semibold text-text-primary mb-2">Umsetzung & Optimierung</h3>
            <p class="text-text-secondary leading-relaxed">
              Ich setze um, messe Ergebnisse und iteriere. Datengesteuert, nicht nach Bauchgefühl.
              Regelmäßige Updates inklusive.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <SpectrumRibbons client:visible variant="divider" />

    <!-- ==================== ÜBER MICH TEASER (Fixed Layout & Glow) ==================== -->
  <section class="vf-glow-section vf-edge-fades py-24 px-6 relative overflow-hidden" aria-labelledby="about-heading">
    
    <!-- Violetter Glow Hintergrund -->
    <div class="vf-glow-layer vf-glow-layer-purple"></div>

    <div class="max-w-5xl mx-auto relative z-10 flex flex-col md:flex-row items-center gap-12 md:gap-16">
      
      <!-- Avatar / Visual (Links) -->
      <div class="reveal relative shrink-0">
        <!-- Glow hinter dem Avatar -->
        <div class="absolute -inset-4 bg-gradient-to-br from-primary via-spectrum-pink to-spectrum-blue opacity-40 blur-2xl rounded-[2.5rem]"></div>
        
        <!-- Avatar Box -->
        <div class="relative w-48 h-48 md:w-64 md:h-64 rounded-[2rem] bg-gradient-to-br from-primary via-spectrum-pink to-spectrum-blue flex items-center justify-center shadow-2xl rotate-3 hover:rotate-0 transition-transform duration-500 border border-white/10">
          <span class="text-6xl md:text-7xl drop-shadow-lg">👤</span>
        </div>
      </div>

      <!-- Text Content (Rechts) -->
      <div class="reveal flex-1 relative" style="transition-delay: 100ms;">
        <!-- Weicher Lesbarkeits-Hintergrund (kein harter Rahmen) -->
        <div class="absolute -inset-6 bg-gradient-to-r from-bg/90 via-bg/60 to-transparent rounded-3xl -z-10 blur-md md:blur-xl"></div>
        
        <p class="vf-kicker font-mono text-xs uppercase tracking-[0.24em] text-primary mb-4">ABOUT_SIGNAL</p>
        <h2 id="about-heading" class="text-3xl md:text-4xl font-display font-bold text-text-primary mb-6">
          Der Mensch hinter <span class="bg-gradient-to-r from-primary to-spectrum-pink bg-clip-text text-transparent">Valorferrum</span>
        </h2>
        <p class="text-text-secondary leading-relaxed mb-8 text-lg">
          Ich bin der Kopf hinter Valorferrum – kein Team, keine Ausreden.
          Als Freelancer verbinde ich Agentur-Erfahrung mit der Effizienz einer Ein-Mann-Operation.
          Technisch tief, marketingstark, immer datenbasiert.
        </p>
        <a href="/de/ueber-mich/" class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-primary/30 hover:border-primary hover:bg-primary/5 text-primary hover:text-primary-light font-medium transition-all group">
          Mehr über mich <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>

    </div>
  </section>

  <SpectrumRibbons client:visible variant="divider" />

  <!-- ==================== BLOG TEASER ==================== -->
  {posts.length > 0 && (
    <section class="vf-fade-section py-24 px-6" aria-labelledby="blog-heading">
      <div class="max-w-6xl mx-auto">
        <div class="flex justify-between items-end mb-12">
          <div>
            <p class="reveal vf-kicker font-mono text-xs uppercase tracking-[0.24em] text-primary mb-2">KNOWLEDGE_BASE</p>
            <h2 id="blog-heading" class="reveal text-3xl md:text-4xl font-display font-bold text-text-primary mb-2">
              Wissen & <span class="bg-gradient-to-r from-primary to-spectrum-pink bg-clip-text text-transparent">Insights</span>
            </h2>
            <p class="reveal text-text-secondary" style="transition-delay: 100ms;">Praxisnahe Einblicke in SEO, SEA und Webentwicklung.</p>
          </div>
          <a href="/de/blog/" class="hidden md:block text-primary hover:text-primary-light font-medium transition-colors">Alle Artikel →</a>
        </div>
        <div class="vf-bento-blog">
  {posts[0] && (
    <a
      href={`/de/blog/${posts[0].slug}/`}
      class="vf-card vf-layer-card card reveal group p-8 rounded-[2rem] bg-surface border border-border hover:border-primary/30 transition-all duration-300 min-h-[360px] flex flex-col justify-end"
    >
      <div class="text-sm text-primary mb-3">
        {new Date(posts[0].data.pubDate).toLocaleDateString('de-DE')}
      </div>
      <h3 class="text-2xl md:text-3xl font-semibold text-text-primary mb-4 group-hover:text-primary transition-colors">
        {posts[0].data.title}
      </h3>
      <p class="text-text-secondary leading-relaxed">
        {posts[0].data.description}
      </p>
    </a>
  )}

  <div class="space-y-6">
    {posts.slice(1).map((post, i) => (
      <a
        href={`/de/blog/${post.slug}/`}
        class="vf-card vf-layer-card card reveal group block p-6 rounded-2xl bg-surface border border-border hover:border-primary/30 transition-all duration-300"
        style={`transition-delay: ${(i + 1) * 100}ms;`}
      >
        <div class="text-sm text-primary mb-3">
          {new Date(post.data.pubDate).toLocaleDateString('de-DE')}
        </div>
        <h3 class="text-xl font-semibold text-text-primary mb-3 group-hover:text-primary transition-colors">
          {post.data.title}
        </h3>
        <p class="text-text-secondary text-sm line-clamp-2">
          {post.data.description}
        </p>
      </a>
    ))}
  </div>
</div>
        <a href="/de/blog/" class="md:hidden mt-6 block text-primary hover:text-primary-light font-medium transition-colors">Alle Artikel →</a>
      </div>
    </section>
  )}

  <SpectrumRibbons client:visible variant="divider" />

    <!-- ==================== CTA (Soft Glow Fade) ==================== -->
  <section class="relative py-32 px-6 overflow-hidden bg-bg" aria-labelledby="cta-heading">
    
    <!-- LAYER 1: Der bunte Glow (weich auslaufend, keine harten Kanten) -->
    <div class="absolute inset-0 z-0 pointer-events-none" aria-hidden="true">
      <!-- Radialer Glow in der Mitte, der nach außen in Transparent/Schwarz übergeht -->
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-spectrum-purple/20 via-spectrum-pink/5 to-transparent"></div>
      
      <!-- Zusätzliche Farb-Akzente (Nebel), die weich ausblenden -->
      <div class="vf-nebula absolute inset-0 opacity-60 mix-blend-screen"></div>
    </div>

    <!-- LAYER 2: Fade-Out nach unten (damit es weich in den Footer/das Ende übergeht) -->
    <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-b from-transparent to-bg z-0 pointer-events-none" aria-hidden="true"></div>
    
    <!-- LAYER 3: Fade-Out nach oben (damit es weich aus der vorherigen Sektion kommt) -->
    <div class="absolute top-0 left-0 right-0 h-32 bg-gradient-to-t from-transparent to-bg z-0 pointer-events-none" aria-hidden="true"></div>

    <!-- Glints (Sterne) -->
    <div class="absolute inset-0 z-0 opacity-80 pointer-events-none">
       <Glints density={12} seed={3} />
    </div>

    <!-- CONTENT (immer scharf, immer oben) -->
    <div class="max-w-3xl mx-auto text-center relative z-10">
      <p class="reveal vf-kicker font-mono text-xs uppercase tracking-[0.24em] text-primary mb-4">INITIAL_CHECK</p>
      <h2 id="cta-heading" class="reveal text-3xl md:text-5xl font-display font-bold text-text-primary mb-6">
        Lass uns prüfen, wo dein größter <span class="bg-gradient-to-r from-primary to-spectrum-pink bg-clip-text text-transparent">Hebel</span> liegt.
      </h2>
      <p class="reveal text-lg text-text-secondary mb-10 leading-relaxed" style="transition-delay: 100ms;">
        Keine Verkaufsmasche. Ein ehrlicher Blick auf Potenzial, Aufwand und Prioritäten –
        ob SEO-Optimierung, Google Ads oder eine neue Website.
      </p>
      <div class="reveal flex flex-col sm:flex-row gap-6 justify-center items-center" style="transition-delay: 200ms;">
        <FlameButton client:visible href="/de/kontakt/" variant="gradient">Kostenloses Erstgespräch</FlameButton>
        <FlameButton client:visible href="/de/preise/" variant="neon">Preise & Pakete</FlameButton>
      </div>
    </div>
  </section>
</Layout>
---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import BrandOrbit from '../../components/BrandOrbit';
import RingRipple from '../../components/RingRipple';
import IronTilt from '../../components/IronTilt';
import CountUp from '../../components/CountUp';
import TechMarquee from '../../components/TechMarquee.astro';

const posts = (await getCollection('blog', (post) => post.data.lang === 'de'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Layout title="Valorferrum – Freelancer & Berater für SEO, SEA & Webentwicklung">

  <!-- ==================== HERO ==================== -->
  <section class="hero section section--hero" aria-label="Hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="hero-glow-left" aria-hidden="true"></div>
    <div class="hero-glow-right" aria-hidden="true"></div>

    <div class="hero-content">
      <svg class="hero-constellation" viewBox="0 0 220 150" aria-hidden="true">
        <path d="M30 25 L185 55 L120 125" fill="none" stroke-width="1" />
        <circle cx="30"  cy="25"  r="6" fill="#C49AFF" style="filter: drop-shadow(0 0 8px #C49AFF);" />
        <circle cx="185" cy="55"  r="6" fill="#3B82F6" style="filter: drop-shadow(0 0 8px #3B82F6);" />
        <circle cx="120" cy="125" r="5" fill="#F8FAFC" style="filter: drop-shadow(0 0 8px #F8FAFC);" />
      </svg>

      <!-- Stage: Quadrat-Bühne = Bezugspunkt für Orbits & Ring -->
      <div class="hero-stage reveal mx-auto">

        <!-- Vorderer Feuerring -->
        <div class="hero-orbit" aria-hidden="true">
          <svg class="hoop-svg" viewBox="0 0 100 100" preserveAspectRatio="none" fill="none" overflow="visible">
            <defs>
              <linearGradient id="fireHoop" x1="0" y1="0" x2="100" y2="100" gradientUnits="userSpaceOnUse">
                <stop offset="0"   stop-color="#5c3578" stop-opacity="0.9"/>
                <stop offset="0.5" stop-color="#EC4899" stop-opacity="0.65"/>
                <stop offset="1"   stop-color="#3a2154" stop-opacity="0.9"/>
              </linearGradient>
            </defs>

            <!-- Tubus: Halo → Mid → Tube → Core -->
            <ellipse class="fr-halo" cx="50" cy="50" rx="49" ry="49" pathLength="100"
              stroke="#A65CF6" stroke-width="26" vector-effect="non-scaling-stroke"/>
            <ellipse class="fr-mid" cx="50" cy="50" rx="49" ry="49" pathLength="100"
              stroke="#A65CF6" stroke-width="13" vector-effect="non-scaling-stroke"/>
            <ellipse class="fr-tube" cx="50" cy="50" rx="49" ry="49" pathLength="100"
              stroke="url(#fireHoop)" stroke-width="6" vector-effect="non-scaling-stroke"/>
            <ellipse class="fr-core" cx="50" cy="50" rx="49" ry="49" pathLength="100"
              stroke="#F5EBFF" stroke-width="1.75" vector-effect="non-scaling-stroke"/>

            <!-- Flammenwelle: Swell (dick) → Aura → Kern → Funke, alle synchron -->
            <ellipse class="fire-swell" cx="50" cy="50" rx="49" ry="49" pathLength="100"
              stroke="#A65CF6" stroke-width="24" vector-effect="non-scaling-stroke" stroke-linecap="round"/>
            <ellipse class="fire-wave fire-wave--aura" cx="50" cy="50" rx="49" ry="49" pathLength="100"
              stroke="#EC4899" stroke-width="14" vector-effect="non-scaling-stroke" stroke-linecap="round"/>
            <ellipse class="fire-wave" cx="50" cy="50" rx="49" ry="49" pathLength="100"
              stroke="#F0E1FF" stroke-width="3.5" vector-effect="non-scaling-stroke" stroke-linecap="round"/>
            <ellipse class="fire-spark" cx="50" cy="50" rx="49" ry="49" pathLength="100"
              stroke="#FFFFFF" stroke-width="4" vector-effect="non-scaling-stroke" stroke-linecap="round"/>
          </svg>
        </div>

        <!-- Hinterer Feuerring -->
        <div class="hero-orbit hero-orbit--far" aria-hidden="true">
          <svg class="hoop-svg" viewBox="0 0 100 100" preserveAspectRatio="none" fill="none" overflow="visible">
            <ellipse class="fr-halo" cx="50" cy="50" rx="49" ry="49" pathLength="100"
              stroke="#7C3AED" stroke-width="20" vector-effect="non-scaling-stroke"/>
            <ellipse class="fr-mid" cx="50" cy="50" rx="49" ry="49" pathLength="100"
              stroke="#7C3AED" stroke-width="10" vector-effect="non-scaling-stroke"/>
            <ellipse class="fr-tube" cx="50" cy="50" rx="49" ry="49" pathLength="100"
              stroke="#3a2154" stroke-width="4" vector-effect="non-scaling-stroke"/>
            <ellipse class="fr-core" cx="50" cy="50" rx="49" ry="49" pathLength="100"
              stroke="#C49AFF" stroke-width="1.25" vector-effect="non-scaling-stroke"/>

            <ellipse class="fire-swell" cx="50" cy="50" rx="49" ry="49" pathLength="100"
              stroke="#7C3AED" stroke-width="18" vector-effect="non-scaling-stroke" stroke-linecap="round"/>
            <ellipse class="fire-wave fire-wave--aura" cx="50" cy="50" rx="49" ry="49" pathLength="100"
              stroke="#A65CF6" stroke-width="10" vector-effect="non-scaling-stroke" stroke-linecap="round"/>
            <ellipse class="fire-wave" cx="50" cy="50" rx="49" ry="49" pathLength="100"
              stroke="#C49AFF" stroke-width="2.5" vector-effect="non-scaling-stroke" stroke-linecap="round"/>
          </svg>
        </div>

        <!-- Der Schmelztiegel -->
        <div class="hero-ring">
          <RingRipple client:only="react" />
          <div class="ring-heat" aria-hidden="true"></div>
          <div class="ring-sheen" aria-hidden="true"></div>
          <div class="ring-embers" aria-hidden="true">
            <span class="ring-ember" style="--x:38%; --c:#EC4899; --d:0s;   --dur:6.5s;"></span>
            <span class="ring-ember" style="--x:56%; --c:#C49AFF; --d:2.2s; --dur:7.5s;"></span>
            <span class="ring-ember" style="--x:47%; --c:#A65CF6; --d:4.1s; --dur:6s;"></span>
          </div>
          <p class="eyebrow justify-center mb-4">
            SEO · SEA · Webentwicklung · Tracking
          </p>
          <h1 class="text-4xl md:text-6xl font-display font-bold tracking-tighter mb-3">
            <span class="brush-accent brush-accent--xl">Valorferrum</span>
          </h1>
          <h2 class="text-lg md:text-2xl font-display font-semibold text-text-primary leading-tight mb-5">
            Dein Freelancer &amp; Berater<br /> für digitale Sichtbarkeit
          </h2>
          <div class="brand-line mx-auto" aria-hidden="true"></div>
        </div>

      </div><!-- /hero-stage -->

      <p class="reveal hero-claim">
        Digitale Sichtbarkeit, die bleibt.<br />
        Performance, die besteht.
      </p>
      <p class="reveal hero-subclaim">
        Dein Erfolg. Mein Maßstab.
      </p>

      <div class="reveal hero-actions justify-center">
        <a href="/de/kontakt/" class="btn btn-primary">Erstgespräch vereinbaren</a>
        <a href="/de/leistungen/" class="btn btn-secondary">Leistungen entdecken</a>
      </div>
    </div>
  </section>

  <TechMarquee />

  <!-- ==================== LEISTUNGEN ==================== -->
  <section class="section section--soft" aria-labelledby="leistungen-heading">
    <div class="ring-echo ring-echo--dashed" style="width:26rem;height:26rem;top:-9rem;right:-10rem;" aria-hidden="true"></div>
    <span class="hero-dot" style="--c:#EC4899; --dur:11s; top:18%; left:6%;" aria-hidden="true"></span>
    <span class="hero-dot" style="--c:#C49AFF; --dur:13s; --d:2s; bottom:14%; right:10%;" aria-hidden="true"></span>

    <div class="section-inner">
      <header class="section-header text-center mx-auto">
        <p class="eyebrow justify-center">01 / Leistungen</p>
        <h2 id="leistungen-heading" class="section-title">
          Vier Disziplinen. <span class="spectrum-text">Eine Strategie.</span>
        </h2>
        <p class="section-intro mx-auto">
          SEO, SEA, Webentwicklung und Tracking greifen ineinander. Ich optimiere Deine Sichtbarkeit
          technisch, inhaltlich und bezahlt – und baue die Infrastruktur, die das alles trägt.
        </p>
      </header>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        <IronTilt href="/de/leistungen/seo/" className="service-card group reveal" client:visible>
          <span class="service-card-num" aria-hidden="true">01</span>
          <div class="service-card-icon" aria-hidden="true">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
          </div>
          <h3 class="service-card-title">SEO & Suchmaschinenoptimierung</h3>
          <p class="service-card-text">Technisches SEO, Onpage und Linkaufbau: Ich bringe Deine Website nach vorne bei Google – nachhaltig und datenbasiert.</p>
          <span class="service-cta">Mehr zur SEO <span aria-hidden="true">→</span></span>
        </IronTilt>

        <IronTilt href="/de/leistungen/sea/" className="service-card group reveal" delay={80} client:visible>
          <span class="service-card-num" aria-hidden="true">02</span>
          <div class="service-card-icon" aria-hidden="true">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122" /></svg>
          </div>
          <h3 class="service-card-title">SEA & Google Ads</h3>
          <p class="service-card-text">Google Werbung & PPC, die sich rechnet: Kampagnen-Setup, Keyword-Strategie und laufende Optimierung.</p>
          <span class="service-cta">Mehr zur SEA <span aria-hidden="true">→</span></span>
        </IronTilt>

        <IronTilt href="/de/leistungen/webentwicklung/" className="service-card group reveal" delay={160} client:visible>
          <span class="service-card-num" aria-hidden="true">03</span>
          <div class="service-card-icon" aria-hidden="true">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
          </div>
          <h3 class="service-card-title">Webentwicklung</h3>
          <p class="service-card-text">Website erstellen lassen mit Astro, WordPress oder TYPO3 – schnell, barrierefrei und mit SEO-Basis-Setup.</p>
          <span class="service-cta">Mehr zur Webentwicklung <span aria-hidden="true">→</span></span>
        </IronTilt>

        <IronTilt href="/de/leistungen/tracking/" className="service-card group reveal" delay={240} client:visible>
          <span class="service-card-num" aria-hidden="true">04</span>
          <div class="service-card-icon" aria-hidden="true">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
          </div>
          <h3 class="service-card-title">Tracking & Analytics</h3>
          <p class="service-card-text">GA4, Tag Manager und Conversion-Tracking – DSGVO-konform. Inkl. Website Tracking Check.</p>
          <span class="service-cta">Mehr zum Tracking <span aria-hidden="true">→</span></span>
        </IronTilt>
      </div>
    </div>
  </section>

  <!-- ==================== WARUM VALORFERRUM ==================== -->
  <section class="section" aria-labelledby="usp-heading">
    <div class="glow-cloud glow-cloud--purple glow-cloud--float" style="width:34rem;height:34rem;top:-10rem;left:-12rem;" aria-hidden="true"></div>
    <div class="glow-cloud glow-cloud--blue" style="width:26rem;height:26rem;bottom:-8rem;right:-10rem;" aria-hidden="true"></div>

    <div class="section-inner">
      <header class="section-header text-center mx-auto">
        <p class="eyebrow justify-center">02 / Differenzierung</p>
        <h2 id="usp-heading" class="section-title">
          Eine Person. Keine Brüche. <span class="spectrum-text">Faire Kalkulation.</span>
        </h2>
        <p class="section-intro mx-auto">
          Keine Silos, keine Kommunikationsketten, keine versteckten Kosten.
          Ich bin Entwickler, Marketer und Analyst in einer Person.
        </p>
      </header>

      <div class="stat-band reveal">
        <div class="stat">
          <div class="stat-value">
            <CountUp to={110} suffix=" €" client:visible />
          </div>
          <div class="stat-label">/ Stunde</div>
          <h3>Transparente Preisgestaltung</h3>
          <p>Fair kalkuliert, nicht ausgedacht. Kostendeckung + Risiko-Puffer.</p>
        </div>

        <div class="stat stat--hero">
          <div class="stat-value">1</div>
          <div class="stat-label">Ansprechpartner</div>
          <h3>Kein Agentur-Overhead</h3>
          <p>Kein Büro, kein PM, keine GF. Du zahlst für meine Zeit und mein Know-how.</p>
        </div>

        <div class="stat">
          <div class="stat-value">
            <CountUp to={100} suffix="%" client:visible />
          </div>
          <div class="stat-label">Ehrlichkeit</div>
          <h3>Realistische Ziele</h3>
          <p>Kein "Platz 1 in 3 Monaten". Wir definieren gemeinsam machbare Erfolge.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== PROZESS: ORBIT-BOGEN (FULL BLEED) ==================== -->
  <section class="section section--soft" aria-labelledby="prozess-heading">
    <div class="ring-echo ring-echo--dashed" style="width:26rem;height:26rem;top:-9rem;right:-10rem;" aria-hidden="true"></div>

    <!-- Header bleibt im zentrierten Container -->
    <div class="section-inner">
      <header class="section-header text-center mx-auto">
        <p class="eyebrow justify-center">03 / Prozess</p>
        <h2 id="prozess-heading" class="section-title">
          So <span class="spectrum-text">arbeiten</span> wir zusammen
        </h2>
      </header>
    </div>

    <!-- Orbit läuft jetzt über die gesamte Desktopbreite -->
    <div class="orbit-wrapper reveal">
      <svg class="orbit-path" viewBox="0 0 100 100" preserveAspectRatio="none" fill="none" aria-hidden="true">
        <defs>
          <linearGradient id="orbitStroke" x1="0" y1="0" x2="100" y2="0" gradientUnits="userSpaceOnUse">
            <stop offset="0"   stop-color="#C49AFF" stop-opacity="0.8"/>
            <stop offset="0.5" stop-color="#EC4899" stop-opacity="0.5"/>
            <stop offset="1"   stop-color="#A65CF6" stop-opacity="0"/>
          </linearGradient>
        </defs>
        <path d="M 0 20 C 40 20, 60 80, 100 80"
              stroke="url(#orbitStroke)" stroke-width="1.5" vector-effect="non-scaling-stroke"/>
        <path class="orbit-comet" d="M 0 20 C 40 20, 60 80, 100 80"
              pathLength="100" stroke="#C49AFF" stroke-width="2"
              vector-effect="non-scaling-stroke" stroke-linecap="round"/>
      </svg>

      <ol class="orbit-steps">
        <li class="orbit-step">
          <span class="orbit-node" style="--c:#C49AFF" aria-hidden="true"></span>
          <p class="mono-label">01</p>
          <h3>Analyse & Status Quo</h3>
          <p>Ich analysiere Deine Website, Dein aktuelles Google Ranking und Deine Wettbewerber. Wo stehst Du – und wo sind die größten Hebel?</p>
        </li>
        <li class="orbit-step">
          <span class="orbit-node" style="--c:#EC4899" aria-hidden="true"></span>
          <p class="mono-label">02</p>
          <h3>Strategie & Konzept</h3>
          <p>Gemeinsam definieren wir Ziele, Budget und Timeline. Ob SEO-Relaunch, neue Google-Ads-Kampagne oder Website-Projekt – das Fundament entscheidet.</p>
        </li>
        <li class="orbit-step">
          <span class="orbit-node" style="--c:#A65CF6" aria-hidden="true"></span>
          <p class="mono-label">03</p>
          <h3>Umsetzung & Optimierung</h3>
          <p>Ich setze um, messe Ergebnisse und iteriere. Datengesteuert, nicht nach Bauchgefühl. Regelmäßige Updates inklusive.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ==================== ÜBER MICH ==================== -->
  <section class="section" aria-labelledby="about-heading">
    <span class="hero-dot" style="--c:#C49AFF; --dur:12s; top:20%; left:8%;" aria-hidden="true"></span>
    <span class="hero-dot" style="--c:#3B82F6; --dur:10s; --d:3s; bottom:18%; right:7%;" aria-hidden="true"></span>

    <div class="section-inner max-w-5xl mx-auto flex flex-col md:flex-row items-center gap-12 md:gap-16">
      <div class="reveal relative shrink-0">
        <div class="absolute -inset-4 bg-gradient-to-br from-primary from-[55%] via-spectrum-pink via-[85%] to-spectrum-blue opacity-30 blur-2xl rounded-[2.5rem]" aria-hidden="true"></div>
        <div class="relative w-48 h-48 md:w-64 md:h-64 rounded-[2rem] bg-gradient-to-br from-primary from-[55%] via-spectrum-pink via-[85%] to-spectrum-blue flex items-center justify-center shadow-2xl rotate-3 hover:rotate-0 transition-transform duration-500 border border-white/10">
          <span class="text-6xl md:text-7xl drop-shadow-lg">👤</span>
        </div>
      </div>

      <div class="reveal flex-1">
        <p class="eyebrow">04 / Über mich</p>
        <h2 id="about-heading" class="section-title mb-6">
          Der Mensch hinter <span class="brush-accent">Valorferrum</span>
        </h2>
        <p class="text-text-secondary leading-relaxed mb-8 text-lg">
          Ich bin der Kopf hinter Valorferrum – kein Team, keine Ausreden.
          Als Freelancer verbinde ich Agentur-Erfahrung mit der Effizienz einer Ein-Mann-Operation.
          Technisch tief, marketingstark, immer datenbasiert.
        </p>
        <a href="/de/ueber-mich/" class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-primary/30 hover:border-primary hover:bg-primary/5 text-primary hover:text-primary-light font-medium transition-all group">
          Mehr über mich <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== BLOG ==================== -->
  {posts.length > 0 && (
    <section class="section section--soft" aria-labelledby="blog-heading">
      <span class="hero-dot" style="--c:#EC4899; --dur:12s; top:12%; right:12%;" aria-hidden="true"></span>

      <div class="section-inner">
        <header class="flex flex-col md:flex-row justify-between items-start md:items-end mb-12 gap-4">
          <div class="section-header mb-0">
            <p class="eyebrow">05 / Blog</p>
            <h2 id="blog-heading" class="section-title mb-2">
              Wissen & <span class="spectrum-text">Insights</span>
            </h2>
            <p class="section-intro">Praxisnahe Einblicke in SEO, SEA und Webentwicklung.</p>
          </div>
          <a href="/de/blog/" class="hidden md:block text-primary hover:text-primary-light font-medium transition-colors">Alle Artikel →</a>
        </header>

        <div class="blog-split reveal">
          <a href={`/de/blog/${posts[0].slug}/`} class="blog-feature group">
            <p class="mono-label">{new Date(posts[0].data.pubDate).toLocaleDateString('de-DE')}</p>
            <h3 class="blog-feature-title">{posts[0].data.title}</h3>
            <p>{posts[0].data.description}</p>
          </a>

          <div class="blog-list">
            {posts.slice(1).map((post) => (
              <a href={`/de/blog/${post.slug}/`} class="blog-row group">
                <div>
                  <p class="mono-label">{new Date(post.data.pubDate).toLocaleDateString('de-DE')}</p>
                  <h4 class="mt-1">{post.data.title}</h4>
                </div>
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            ))}
          </div>
        </div>

        <a href="/de/blog/" class="md:hidden mt-6 block text-primary hover:text-primary-light font-medium transition-colors">Alle Artikel →</a>
      </div>
    </section>
  )}

  <!-- ==================== CTA ==================== -->
  <section class="section section--cta" aria-labelledby="cta-heading">
    <div class="ring-echo ring-echo--dashed" style="width:38rem;height:38rem;left:50%;top:50%;transform:translate(-50%,-50%);" aria-hidden="true"></div>
    <span class="hero-dot" style="--c:#C49AFF; --dur:11s; top:22%; left:18%;" aria-hidden="true"></span>
    <span class="hero-dot" style="--c:#EC4899; --dur:13s; --d:2s; bottom:20%; right:16%;" aria-hidden="true"></span>

    <div class="section-inner max-w-3xl mx-auto text-center relative z-10">
      <p class="eyebrow justify-center">06 / Kontakt</p>
      <h2 id="cta-heading" class="section-title text-3xl md:text-5xl mb-6">
        Lass uns prüfen, wo dein größter <span class="brush-accent">Hebel</span> liegt.
      </h2>
      <p class="text-lg text-text-secondary mb-10 leading-relaxed max-w-2xl mx-auto">
        Keine Verkaufsmasche. Ein ehrlicher Blick auf Potenzial, Aufwand und Prioritäten –
        ob SEO-Optimierung, Google Ads oder eine neue Website.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-5">
        <a href="/de/kontakt/" class="btn btn-primary">Kostenloses Erstgespräch</a>
        <a href="/de/preise/" class="btn btn-secondary">Preise & Pakete</a>
      </div>
    </div>
  </section>

</Layout>
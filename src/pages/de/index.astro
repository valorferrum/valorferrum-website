---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import BrandOrbit from '../../components/BrandOrbit';

// Neueste DE-Artikel für den Blog-Teaser (§8 Content-Architektur)
const posts = (await getCollection('blog', (post) => post.data.lang === 'de'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Layout title="Valorferrum – Freelancer & Berater für SEO, SEA & Webentwicklung">

  <!-- ==================== HERO: CHROME RING (REV 6) ==================== -->
  <section class="hero relative min-h-screen flex flex-col items-center justify-center overflow-hidden bg-bg px-6 py-24">

    <!-- Ambient Side-Glows: Lila links, Blau rechts -->
    <div class="hero-glow-left" aria-hidden="true"></div>
    <div class="hero-glow-right" aria-hidden="true"></div>

    <!-- Konstellation oben rechts -->
    <svg class="hero-constellation" viewBox="0 0 220 150" aria-hidden="true">
      <path d="M30 25 L185 55 L120 125" fill="none" stroke="rgba(248,250,252,0.3)" stroke-width="1" />
      <circle cx="30"  cy="25"  r="6" fill="#C49AFF" style="filter: drop-shadow(0 0 8px #C49AFF);" />
      <circle cx="185" cy="55"  r="6" fill="#3B82F6" style="filter: drop-shadow(0 0 8px #3B82F6);" />
      <circle cx="120" cy="125" r="5" fill="#F8FAFC" style="filter: drop-shadow(0 0 8px #F8FAFC);" />
    </svg>

    <!-- Ring-Bühne mit animiertem Orbit -->
    <div class="hero-stage reveal">
      <!-- Animierter Orbit (Lila-dominant), läuft hinter dem Ring -->
      <BrandOrbit
        client:visible
        className="inset-y-[2%] -inset-x-[20%]"
        tilt={-14}
        rx={0.5}
        ry={0.32}
        duration={28}
      />

      <div class="hero-ring">
        <p class="font-mono text-xs uppercase tracking-[0.28em] text-text-secondary mb-4">
          SEO · SEA · Webentwicklung · Tracking
        </p>

        <!-- Headline: Brandgradient, KEIN Chrome -->
        <h1 class="text-4xl md:text-6xl font-display font-bold tracking-tighter mb-3">
          <span class="spectrum-text">Valorferrum</span>
        </h1>

        <h2 class="text-lg md:text-2xl font-display font-semibold text-text-primary leading-tight mb-5">
          Dein Freelancer &amp; Berater<br /> für digitale Sichtbarkeit
        </h2>
        <div class="brand-line" aria-hidden="true"></div>
      </div>
    </div>

    <!-- Claim unter dem Ring -->
    <p class="reveal text-text-secondary text-center max-w-xl mx-auto mt-12 mb-10 leading-relaxed">
      Digitale Sichtbarkeit, die bleibt. Performance, die besteht.
      <span class="text-text-muted italic">Dein Erfolg. Mein Maßstab.</span>
    </p>

    <!-- Buttons -->
    <div class="reveal flex flex-col sm:flex-row items-center gap-5">
      <a href="/de/kontakt/" class="btn btn-primary">Erstgespräch vereinbaren</a>
      <a href="/de/leistungen/" class="btn btn-secondary">Leistungen entdecken</a>
    </div>
  </section>

  <!-- Hero → Content -->
  <div class="relative z-10 -mt-10 md:-mt-16">
    <!-- Platzhalter für Wellen-Übergang -->
  </div>

  <!-- ==================== LEISTUNGEN (Cards) ==================== -->
  <section class="relative py-24 px-6 overflow-hidden" aria-labelledby="leistungen-heading">
    <div class="max-w-6xl mx-auto relative z-10">
      <div class="text-center mb-16">
        <p class="reveal font-mono text-xs uppercase tracking-[0.24em] text-primary-light mb-4">SERVICE_SYSTEM</p>
        <h2 id="leistungen-heading" class="reveal text-3xl md:text-4xl font-display font-bold text-text-primary mb-4">
          Vier Disziplinen. <span class="spectrum-text">Eine Strategie.</span>
        </h2>
        <p class="reveal text-text-secondary max-w-2xl mx-auto">
          SEO, SEA, Webentwicklung und Tracking greifen ineinander. Ich optimiere Deine Sichtbarkeit
          technisch, inhaltlich und bezahlt – und baue die Infrastruktur, die das alles trägt.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        <!-- SEO -->
        <a href="/de/leistungen/seo/" class="card group">
          <div class="w-12 h-12 rounded-full border border-primary/30 bg-primary/10 flex items-center justify-center mb-6">
            <svg class="w-5 h-5 text-primary-light" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
          </div>
          <h3 class="text-lg font-display font-semibold text-text-primary mb-3">SEO & Suchmaschinenoptimierung</h3>
          <p class="text-text-secondary text-sm leading-relaxed mb-4">
            Technisches SEO, Onpage und Linkaufbau: Ich bringe Deine Website nach vorne bei Google – nachhaltig und datenbasiert.
          </p>
          <span class="text-primary-light text-sm font-medium inline-flex items-center gap-2 group-hover:gap-3 transition-all">
            Mehr zur SEO <span aria-hidden="true">→</span>
          </span>
        </a>

        <!-- SEA -->
        <a href="/de/leistungen/sea/" class="card group">
          <div class="w-12 h-12 rounded-full border border-primary/30 bg-primary/10 flex items-center justify-center mb-6">
            <svg class="w-5 h-5 text-primary-light" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122" /></svg>
          </div>
          <h3 class="text-lg font-display font-semibold text-text-primary mb-3">SEA & Google Ads</h3>
          <p class="text-text-secondary text-sm leading-relaxed mb-4">
            Google Werbung & PPC, die sich rechnet: Kampagnen-Setup, Keyword-Strategie und laufende Optimierung.
          </p>
          <span class="text-primary-light text-sm font-medium inline-flex items-center gap-2 group-hover:gap-3 transition-all">
            Mehr zur SEA <span aria-hidden="true">→</span>
          </span>
        </a>

        <!-- Webentwicklung -->
        <a href="/de/leistungen/webentwicklung/" class="card group">
          <div class="w-12 h-12 rounded-full border border-primary/30 bg-primary/10 flex items-center justify-center mb-6">
            <svg class="w-5 h-5 text-primary-light" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
          </div>
          <h3 class="text-lg font-display font-semibold text-text-primary mb-3">Webentwicklung</h3>
          <p class="text-text-secondary text-sm leading-relaxed mb-4">
            Website erstellen lassen mit Astro, WordPress oder TYPO3 – schnell, barrierefrei und mit SEO-Basis-Setup.
          </p>
          <span class="text-primary-light text-sm font-medium inline-flex items-center gap-2 group-hover:gap-3 transition-all">
            Mehr zur Webentwicklung <span aria-hidden="true">→</span>
          </span>
        </a>

        <!-- Tracking -->
        <a href="/de/leistungen/tracking/" class="card group">
          <div class="w-12 h-12 rounded-full border border-primary/30 bg-primary/10 flex items-center justify-center mb-6">
            <svg class="w-5 h-5 text-primary-light" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
          </div>
          <h3 class="text-lg font-display font-semibold text-text-primary mb-3">Tracking & Analytics</h3>
          <p class="text-text-secondary text-sm leading-relaxed mb-4">
            GA4, Tag Manager und Conversion-Tracking – DSGVO-konform. Inkl. Website Tracking Check.
          </p>
          <span class="text-primary-light text-sm font-medium inline-flex items-center gap-2 group-hover:gap-3 transition-all">
            Mehr zum Tracking <span aria-hidden="true">→</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== WARUM VALORFERRUM ==================== -->
  <section class="py-24 px-6 relative overflow-hidden" aria-labelledby="usp-heading">
    <div class="max-w-6xl mx-auto relative z-10">
      <div class="text-center mb-16">
        <p class="reveal font-mono text-xs uppercase tracking-[0.24em] text-primary-light mb-4">WHY_VALORFERRUM</p>
        <h2 id="usp-heading" class="reveal text-3xl md:text-4xl font-display font-bold text-text-primary mb-4">
          Eine Person. Keine Brüche. <span class="spectrum-text">Faire Kalkulation.</span>
        </h2>
        <p class="reveal text-text-secondary max-w-2xl mx-auto">
          Keine Silos, keine Kommunikationsketten, keine versteckten Kosten.
          Ich bin Entwickler, Marketer und Analyst in einer Person.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-border/60">
        <!-- USP 1 -->
        <div class="reveal p-8 md:p-12 text-center">
          <div class="text-4xl font-display font-bold mb-2 spectrum-text inline-block">110 €</div>
          <div class="text-sm text-text-muted uppercase tracking-wide mb-4">/ Stunde</div>
          <h3 class="text-lg font-semibold text-text-primary mb-3">Transparente Preisgestaltung</h3>
          <p class="text-text-secondary text-sm leading-relaxed">Fair kalkuliert, nicht ausgedacht. Kostendeckung + Risiko-Puffer.</p>
        </div>

        <!-- USP 2 -->
        <div class="reveal p-8 md:p-12 text-center bg-gradient-to-b from-transparent via-primary/5 to-transparent" style="transition-delay:100ms;">
          <div class="text-6xl font-display font-bold mb-2 spectrum-text inline-block">1</div>
          <div class="text-base text-text-primary font-medium uppercase tracking-wide mb-4">Ansprechpartner</div>
          <h3 class="text-2xl font-semibold text-text-primary mb-3">Kein Agentur-Overhead</h3>
          <p class="text-text-secondary leading-relaxed max-w-xs mx-auto">Kein Büro, kein PM, keine GF. Du zahlst für meine Zeit und mein Know-how.</p>
        </div>

        <!-- USP 3 -->
        <div class="reveal p-8 md:p-12 text-center" style="transition-delay:200ms;">
          <div class="text-4xl font-display font-bold mb-2 spectrum-text inline-block">100%</div>
          <div class="text-sm text-text-muted uppercase tracking-wide mb-4">Ehrlichkeit</div>
          <h3 class="text-lg font-semibold text-text-primary mb-3">Realistische Ziele</h3>
          <p class="text-text-secondary text-sm leading-relaxed">Kein "Platz 1 in 3 Monaten". Wir definieren gemeinsam machbare Erfolge.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== PROZESS ==================== -->
  <section class="py-24 px-6 relative overflow-hidden bg-bg-elevated/40" aria-labelledby="prozess-heading">
    <div class="max-w-4xl mx-auto relative z-10">
      <div class="text-center mb-16">
        <p class="reveal font-mono text-xs uppercase tracking-[0.24em] text-primary-light mb-4">PROCESS_FLOW</p>
        <h2 id="prozess-heading" class="reveal text-3xl md:text-4xl font-display font-bold text-text-primary mb-4">
          So <span class="spectrum-text">arbeiten</span> wir zusammen
        </h2>
      </div>

      <div class="space-y-6">
        <div class="card">
          <div class="flex gap-6">
            <div class="text-3xl font-display font-bold shrink-0 w-12 spectrum-text">01</div>
            <div>
              <h3 class="text-lg font-semibold text-text-primary mb-2">Analyse & Status Quo</h3>
              <p class="text-text-secondary leading-relaxed">
                Ich analysiere Deine Website, Dein aktuelles Google Ranking und Deine Wettbewerber.
                Wo stehst Du – und wo sind die größten Hebel?
              </p>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="flex gap-6">
            <div class="text-3xl font-display font-bold shrink-0 w-12 spectrum-text">02</div>
            <div>
              <h3 class="text-lg font-semibold text-text-primary mb-2">Strategie & Konzept</h3>
              <p class="text-text-secondary leading-relaxed">
                Gemeinsam definieren wir Ziele, Budget und Timeline. Ob SEO-Relaunch, neue Google-Ads-Kampagne
                oder Website-Projekt – das Fundament entscheidet.
              </p>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="flex gap-6">
            <div class="text-3xl font-display font-bold shrink-0 w-12 spectrum-text">03</div>
            <div>
              <h3 class="text-lg font-semibold text-text-primary mb-2">Umsetzung & Optimierung</h3>
              <p class="text-text-secondary leading-relaxed">
                Ich setze um, messe Ergebnisse und iteriere. Datengesteuert, nicht nach Bauchgefühl.
                Regelmäßige Updates inklusive.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== ÜBER MICH TEASER ==================== -->
  <section class="py-24 px-6 relative overflow-hidden" aria-labelledby="about-heading">
    <div class="max-w-5xl mx-auto relative z-10 flex flex-col md:flex-row items-center gap-12 md:gap-16">
      <!-- Avatar / Visual -->
      <div class="reveal relative shrink-0">
        <div class="absolute -inset-4 bg-gradient-to-br from-primary via-spectrum-pink to-spectrum-blue opacity-30 blur-2xl rounded-[2.5rem]" aria-hidden="true"></div>
        <div class="relative w-48 h-48 md:w-64 md:h-64 rounded-[2rem] bg-gradient-to-br from-primary via-spectrum-pink to-spectrum-blue flex items-center justify-center shadow-2xl rotate-3 hover:rotate-0 transition-transform duration-500 border border-white/10">
          <span class="text-6xl md:text-7xl drop-shadow-lg">👤</span>
        </div>
      </div>

      <!-- Text -->
      <div class="reveal flex-1">
        <p class="font-mono text-xs uppercase tracking-[0.24em] text-primary-light mb-4">ABOUT_SIGNAL</p>
        <h2 id="about-heading" class="text-3xl md:text-4xl font-display font-bold text-text-primary mb-6">
          Der Mensch hinter <span class="spectrum-text">Valorferrum</span>
        </h2>
        <p class="text-text-secondary leading-relaxed mb-8 text-lg">
          Ich bin der Kopf hinter Valorferrum – kein Team, keine Ausreden.
          Als Freelancer verbinde ich Agentur-Erfahrung mit der Effizienz einer Ein-Mann-Operation.
          Technisch tief, marketingstark, immer datenbasiert.
        </p>
        <a href="/de/ueber-mich/" class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-primary/30 hover:border-primary hover:bg-primary/5 text-primary hover:text-primary-light font-medium transition-all group">
          Mehr über mich <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== BLOG TEASER ==================== -->
  {posts.length > 0 && (
    <section class="py-24 px-6" aria-labelledby="blog-heading">
      <div class="max-w-6xl mx-auto">
        <div class="flex justify-between items-end mb-12">
          <div>
            <p class="reveal font-mono text-xs uppercase tracking-[0.24em] text-primary-light mb-2">KNOWLEDGE_BASE</p>
            <h2 id="blog-heading" class="reveal text-3xl md:text-4xl font-display font-bold text-text-primary mb-2">
              Wissen & <span class="spectrum-text">Insights</span>
            </h2>
            <p class="reveal text-text-secondary">Praxisnahe Einblicke in SEO, SEA und Webentwicklung.</p>
          </div>
          <a href="/de/blog/" class="hidden md:block text-primary hover:text-primary-light font-medium transition-colors">Alle Artikel →</a>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          {posts.map((post, i) => (
            <a
              href={`/de/blog/${post.slug}/`}
              class="reveal group relative p-6 rounded-2xl bg-surface/70 backdrop-blur-md border border-border hover:border-primary/40 transition-all duration-300 overflow-hidden"
              style={`transition-delay:${(i+1) * 100}ms;`}
            >
              <div class="absolute top-0 left-0 right-0 h-0.5 bg-gradient-to-r from-spectrum-purple to-spectrum-pink opacity-70" aria-hidden="true"></div>
              <div class="text-sm text-primary mb-3">{new Date(post.data.pubDate).toLocaleDateString('de-DE')}</div>
              <h3 class="text-xl font-semibold text-text-primary mb-3 group-hover:text-primary-light transition-colors">{post.data.title}</h3>
              <p class="text-text-secondary text-sm line-clamp-3">{post.data.description}</p>
            </a>
          ))}
        </div>

        <a href="/de/blog/" class="md:hidden mt-6 block text-primary hover:text-primary-light font-medium transition-colors">Alle Artikel →</a>
      </div>
    </section>
  )}

  <!-- optional: vor der CTA-Sektion, etwas dezenter -->
  <!-- Platzhalter für Wellen-Übergang -->

  <!-- ==================== CTA ==================== -->
  <section class="relative py-32 px-6 overflow-hidden bg-bg" aria-labelledby="cta-heading">
    <div class="max-w-3xl mx-auto text-center relative z-10">
      <p class="reveal font-mono text-xs uppercase tracking-[0.24em] text-primary-light mb-4">INITIAL_CHECK</p>
      <h2 id="cta-heading" class="reveal text-3xl md:text-5xl font-display font-bold text-text-primary mb-6">
        Lass uns prüfen, wo dein größter <span class="spectrum-text">Hebel</span> liegt.
      </h2>
      <p class="reveal text-lg text-text-secondary mb-10 leading-relaxed">
        Keine Verkaufsmasche. Ein ehrlicher Blick auf Potenzial, Aufwand und Prioritäten –
        ob SEO-Optimierung, Google Ads oder eine neue Website.
      </p>
      <div class="reveal flex flex-col items-center gap-5">
        <a href="/de/kontakt/" class="btn btn-primary">Kostenloses Erstgespräch</a>
        <a href="/de/preise/" class="btn btn-secondary">Preise & Pakete</a>
      </div>
    </div>
  </section>

</Layout>
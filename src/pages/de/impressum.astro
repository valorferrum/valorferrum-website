---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Impressum - Valorferrum" description="Impressum und rechtliche Angaben.">
  <section class="pt-32 pb-24 px-4">
    <div class="max-w-3xl mx-auto">
      <h1 class="font-display text-4xl font-bold text-text-primary mb-8 reveal">Impressum</h1>
      <div class="reveal space-y-8 text-text-secondary">
        <div class="p-6 rounded-xl bg-surface border border-border">
          <h2 class="font-display text-xl font-semibold text-text-primary mb-4">Angaben gemäß § 5 TMG</h2>
          <p class="mb-2"><strong class="text-text-primary">[Dein Name]</strong></p>
          <p class="mb-2">Valorferrum</p>
          <p class="mb-2">[Straße Hausnummer]</p>
          <p class="mb-2">[PLZ Ort]</p>
          <p class="mb-2">Deutschland</p>
        </div>
        <div class="p-6 rounded-xl bg-surface border border-border">
          <h2 class="font-display text-xl font-semibold text-text-primary mb-4">Kontakt</h2>
          <p class="mb-2">Telefon: [Telefonnummer]</p>
          <p class="mb-2">E-Mail: hello@valorferrum.de</p>
        </div>
        <div class="p-6 rounded-xl bg-surface border border-border">
          <h2 class="font-display text-xl font-semibold text-text-primary mb-4">Umsatzsteuer-ID</h2>
          <p>Umsatzsteuer-Identifikationsnummer gemäß §27 a Umsatzsteuergesetz:</p>
          <p class="text-text-muted">[USt-IdNr.]</p>
        </div>
        <div class="p-6 rounded-xl bg-surface border border-border">
          <h2 class="font-display text-xl font-semibold text-text-primary mb-4">Berufshaftpflichtversicherung</h2>
          <p>[Name und Sitz der Versicherung]</p>
          <p class="text-text-muted">[Geltungsraum der Versicherung]</p>
        </div>
      </div>
    </div>
  </section>
</Layout>